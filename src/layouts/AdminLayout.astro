---
import '../styles/global.css';
import { siteConfig, getBrandInitials } from '../config/site';

interface Props {
  title?: string;
  activeSection?: 'dashboard' | 'orders' | 'products' | 'categories' | 'gallery';
}

const { title = 'Dashboard', activeSection = 'dashboard' } = Astro.props;
const brandInitials = getBrandInitials(siteConfig.brand.name);
const pageTitle = title.includes(siteConfig.brand.name)
  ? title
  : `${title} — ${siteConfig.brand.name} Admin`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={`${siteConfig.brand.name} Admin`} />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-surface flex flex-col text-text-primary antialiased">
    <!-- Auth Verification Loading Overlay -->
    <div id="admin-auth-guard" class="fixed inset-0 bg-surface z-50 flex flex-col items-center justify-center gap-4 transition-opacity duration-300">
      <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white flex items-center justify-center font-bold text-xl shadow-lg animate-pulse">
        {brandInitials}
      </div>
      <div class="flex items-center gap-2 text-text-secondary text-sm">
        <svg class="animate-spin w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Verifying admin credentials...</span>
      </div>
    </div>

    <!-- Admin Top Navigation Bar -->
    <header class="bg-surface-bright border-b border-border sticky top-0 z-40">
      <div class="container-page py-3.5 flex items-center justify-between">
        <!-- Logo & Context -->
        <div class="flex items-center gap-4">
          <a href="/admin" class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-base shadow-sm">
              {brandInitials}
            </div>
            <div>
              <div class="font-bold text-base tracking-tight leading-none">{siteConfig.brand.name}</div>
              <div class="text-[10px] text-text-tertiary uppercase tracking-wider font-semibold mt-0.5">Admin Workspace</div>
            </div>
          </a>

          <div class="hidden sm:block h-6 w-px bg-border"></div>

          <!-- Navigation Links -->
          <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
            <a
              href="/admin"
              class={`px-3 py-1.5 rounded-lg transition-colors ${
                activeSection === 'dashboard'
                  ? 'bg-brand-50 text-brand-700 font-semibold'
                  : 'text-text-secondary hover:text-text-primary hover:bg-surface-muted'
              }`}
            >
              Dashboard
            </a>
            <a
              href="/admin/products"
              class={`px-3 py-1.5 rounded-lg transition-colors ${
                activeSection === 'products'
                  ? 'bg-brand-50 text-brand-700 font-semibold'
                  : 'text-text-secondary hover:text-text-primary hover:bg-surface-muted'
              }`}
            >
              Products
            </a>
            <a
              href="/admin/categories"
              class={`px-3 py-1.5 rounded-lg transition-colors ${
                activeSection === 'categories'
                  ? 'bg-brand-50 text-brand-700 font-semibold'
                  : 'text-text-secondary hover:text-text-primary hover:bg-surface-muted'
              }`}
            >
              Categories
            </a>
            <a
              href="/admin/gallery"
              class={`px-3 py-1.5 rounded-lg transition-colors ${
                activeSection === 'gallery'
                  ? 'bg-brand-50 text-brand-700 font-semibold'
                  : 'text-text-secondary hover:text-text-primary hover:bg-surface-muted'
              }`}
            >
              Inspiration Gallery
            </a>
          </nav>
        </div>

        <!-- Admin Profile & Controls -->
        <div class="flex items-center gap-3">
          <a
            href="/"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs text-text-secondary hover:text-brand-600 px-3 py-1.5 rounded-lg border border-border-subtle bg-surface hover:bg-surface-muted transition-colors"
          >
            <span>Live Store</span>
            <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <!-- User Badge -->
          <div class="flex items-center gap-2 px-3 py-1.5 bg-surface rounded-xl border border-border-subtle">
            <div class="w-2 h-2 rounded-full bg-success"></div>
            <div class="text-xs">
              <span id="header-admin-email" class="font-medium text-text-primary">Loading...</span>
              <span id="header-admin-role" class="ml-1 text-[10px] uppercase font-bold text-brand-700 bg-brand-100 px-1.5 py-0.5 rounded">Admin</span>
            </div>
          </div>

          <!-- Sign Out Button -->
          <button
            id="admin-logout-btn"
            type="button"
            class="px-3 py-1.5 text-xs font-medium text-danger hover:bg-danger/10 rounded-lg transition-colors flex items-center gap-1.5 border border-transparent hover:border-danger/20"
            title="Sign out of Admin Portal"
          >
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span class="hidden sm:inline">Sign Out</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Sub-navigation -->
    <div class="md:hidden bg-surface-bright border-b border-border px-4 py-2 flex items-center gap-2 overflow-x-auto text-xs font-medium">
      <a href="/admin" class={`px-3 py-1.5 rounded-lg whitespace-nowrap ${activeSection === 'dashboard' ? 'bg-brand-100 text-brand-700 font-semibold' : 'text-text-secondary'}`}>Dashboard</a>
      <a href="/admin/products" class={`px-3 py-1.5 rounded-lg whitespace-nowrap ${activeSection === 'products' ? 'bg-brand-100 text-brand-700 font-semibold' : 'text-text-secondary'}`}>Products</a>
      <a href="/admin/categories" class={`px-3 py-1.5 rounded-lg whitespace-nowrap ${activeSection === 'categories' ? 'bg-brand-100 text-brand-700 font-semibold' : 'text-text-secondary'}`}>Categories</a>
      <a href="/admin/gallery" class={`px-3 py-1.5 rounded-lg whitespace-nowrap ${activeSection === 'gallery' ? 'bg-brand-100 text-brand-700 font-semibold' : 'text-text-secondary'}`}>Inspiration Gallery</a>
    </div>

    <!-- Main Admin Content Area -->
    <main class="flex-1 container-page py-8">
      <slot />
    </main>

    <script>
      import { supabase, verifyAdminSession, adminSignOut } from '../lib/supabase';

      const guardOverlay = document.getElementById('admin-auth-guard');
      const headerEmail = document.getElementById('header-admin-email');
      const headerRole = document.getElementById('header-admin-role');
      const logoutBtn = document.getElementById('admin-logout-btn');

      // 1. Enforce Authentication & Admin Role
      async function enforceAdminAuth() {
        try {
          const authData = await verifyAdminSession();

          if (!authData) {
            window.location.replace('/admin/login?error=unauthorized');
            return;
          }

          // Populate admin details in header
          if (headerEmail) {
            headerEmail.textContent = authData.admin.email;
          }
          if (headerRole) {
            headerRole.textContent = authData.admin.role.replace('_', ' ');
          }

          // Dispatch event with verified admin profile for pages to use
          (window as any).__templateAdminReady = authData;
          window.dispatchEvent(
            new CustomEvent('template:admin-ready', {
              detail: authData,
            })
          );

          // Fade out the loading guard
          if (guardOverlay) {
            guardOverlay.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              guardOverlay.classList.add('hidden');
            }, 300);
          }
        } catch (err) {
          console.error('Admin guard check failed:', err);
          window.location.replace('/admin/login?error=unauthorized');
        }
      }

      // 2. Setup auth state listener for real-time invalidation
      supabase.auth.onAuthStateChange((event, session) => {
        if (event === 'SIGNED_OUT' || !session) {
          window.location.replace('/admin/login?error=session_expired');
        }
      });

      // 3. Attach logout handler
      logoutBtn?.addEventListener('click', async () => {
        if (confirm('Are you sure you want to sign out of the Admin Portal?')) {
          await adminSignOut();
        }
      });

      // Run on initial load
      enforceAdminAuth();
    </script>
  </body>
</html>
