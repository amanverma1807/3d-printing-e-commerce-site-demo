---
import { siteConfig, getWhatsAppLink, hasWhatsApp, hasEmail, hasSocial } from '../config/site';

interface Props {
  categories?: { name: string; slug: string }[];
}

const { categories } = Astro.props;
const displayCategories = categories !== undefined ? categories : siteConfig.categories;
---

<footer class="bg-stone-950 border-t border-stone-800 mt-auto text-stone-300">
  <div class="container-page py-16 sm:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 pb-16 border-b border-stone-800">
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-4">
        <a href="/" class="group inline-flex items-center gap-2.5 text-xl font-semibold tracking-tight text-white mb-4">
          <img src="/favicon.svg" alt={`${siteConfig.brand.name} logo`} width="26" height="26" class="w-6.5 h-6.5 rounded-md object-contain shrink-0 brightness-0 invert" />
          <span>{siteConfig.brand.name}</span>
        </a>
        <p class="text-sm text-stone-400 leading-relaxed max-w-sm mb-6 font-light">
          Quality craftsmanship delivered directly to your door. Curated collections, thoughtful design, and reliable service.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-stone-900 border border-stone-800 text-xs text-stone-300 font-mono">
          <span class="w-2 h-2 rounded-full bg-accent-500 animate-pulse"></span>
          <span>Quality Assured · Fast Delivery</span>
        </div>
      </div>

      <!-- Shop Links -->
      <div class="lg:col-span-2 lg:col-start-6">
        <h3 class="text-xs font-mono uppercase tracking-widest font-semibold text-white mb-5">Shop Catalog</h3>
        <ul class="space-y-3" role="list">
          <li><a href="/shop" class="text-sm text-stone-400 hover:text-white transition-colors font-light">All Products</a></li>
          <li><a href="/shop?sort=featured" class="text-sm text-stone-400 hover:text-white transition-colors font-light">Featured Items</a></li>
          <li><a href="/shop?sort=newest" class="text-sm text-stone-400 hover:text-white transition-colors font-light">New Releases</a></li>
          {displayCategories.slice(0, 2).map((cat) => (
            <li><a href={`/shop?category=${cat.slug}`} class="text-sm text-stone-400 hover:text-white transition-colors font-light">{cat.name}</a></li>
          ))}
          <li><a href="/track-order" class="text-sm font-medium text-accent-500 hover:text-accent-400 transition-colors">Track My Order →</a></li>
        </ul>
      </div>

      <!-- Company Links -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-mono uppercase tracking-widest font-semibold text-white mb-5">Company</h3>
        <ul class="space-y-3" role="list">
          <li><a href="/about" class="text-sm text-stone-400 hover:text-white transition-colors font-light">About Us</a></li>
          {siteConfig.features.enableCustomOrders && (
            <li><a href="/custom" class="text-sm text-stone-400 hover:text-white transition-colors font-light">Custom Orders</a></li>
          )}
          <li><a href="/contact" class="text-sm text-stone-400 hover:text-white transition-colors font-light">Contact Us</a></li>
          {hasWhatsApp() && (
            <li><a href={getWhatsAppLink()} target="_blank" rel="noopener noreferrer" class="text-sm text-stone-400 hover:text-white transition-colors font-light">WhatsApp: {siteConfig.contact.whatsappDisplay || siteConfig.contact.whatsapp}</a></li>
          )}
          {hasEmail() && (
            <li><a href={`mailto:${siteConfig.contact.email}`} class="text-sm text-stone-400 hover:text-white transition-colors font-light">{siteConfig.contact.email}</a></li>
          )}
        </ul>
      </div>

      <!-- Policies & Assurance -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-mono uppercase tracking-widest font-semibold text-white mb-5">Policies & Care</h3>
        <ul class="space-y-3" role="list">
          <li><a href="/return-policy" class="text-sm text-stone-400 hover:text-white transition-colors font-light">Return Policy</a></li>
          <li><a href="/refund-policy" class="text-sm text-stone-400 hover:text-white transition-colors font-light">Refund & Replacement</a></li>
          <li><a href="/privacy-policy" class="text-sm text-stone-400 hover:text-white transition-colors font-light">Privacy Policy</a></li>
          <li><a href="/disclaimer" class="text-sm text-stone-400 hover:text-white transition-colors font-light">Disclaimer & Guidelines</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom sub-bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-xs text-stone-500 font-light">
        <p>© {new Date().getFullYear()} {siteConfig.brand.name}. All rights reserved.</p>
        <div class="flex items-center gap-3">
          <a href="/privacy-policy" class="hover:text-stone-300 transition-colors">Privacy</a>
          <span>·</span>
          <a href="/refund-policy" class="hover:text-stone-300 transition-colors">Refunds</a>
          <span>·</span>
          <a href="/return-policy" class="hover:text-stone-300 transition-colors">Returns</a>
        </div>
        <span class="hidden sm:inline">·</span>
        <a href="#" class="hover:text-stone-300 transition-colors">Built by Aman Verma</a>
      </div>

      <!-- Trust note & Social links -->
      <div class="flex items-center gap-5">
        <span class="text-xs text-stone-400 font-mono">Secured by Razorpay</span>
        {hasSocial('instagram') && (
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-stone-500 hover:text-white transition-colors text-xs font-mono"
            aria-label="Instagram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
            <span>{siteConfig.social.instagramHandle}</span>
          </a>
        )}
      </div>
    </div>
  </div>
</footer>
