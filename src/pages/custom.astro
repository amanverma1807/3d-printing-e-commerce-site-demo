---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { siteConfig, getWhatsAppLink } from '../config/site';
---

<Layout title={`Custom Orders — ${siteConfig.brand.name}`}>
  <!-- Hero -->
  <section class="py-20 bg-gradient-to-br from-brand-50 to-surface">
    <div class="container-page max-w-4xl text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-text-primary mb-6">Custom & Bespoke Orders</h1>
      <p class="text-xl text-text-secondary mb-10">
        Bring your ideas to life. From personalized items to bulk orders, we'll help make your vision a reality.
      </p>
      <Button href={getWhatsAppLink('Hi! I have a custom order request.')} size="lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Get Started on WhatsApp
      </Button>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-surface">
    <div class="container-page max-w-5xl">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-12 text-center">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center text-2xl font-bold">1</div>
          <h3 class="text-xl font-semibold text-text-primary mb-3">Share Your Idea</h3>
          <p class="text-text-secondary">Send us your design ideas, sketches, specifications, or reference images via WhatsApp.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center text-2xl font-bold">2</div>
          <h3 class="text-xl font-semibold text-text-primary mb-3">We Review & Quote</h3>
          <p class="text-text-secondary">Our team reviews your requirements, provides an accurate quote, and prepares the production plan.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center text-2xl font-bold">3</div>
          <h3 class="text-xl font-semibold text-text-primary mb-3">Crafted & Shipped</h3>
          <p class="text-text-secondary">Once approved, we carefully produce your custom piece with precision and ship it to you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Can Create -->
  <section class="py-20 bg-surface-muted">
    <div class="container-page max-w-4xl">
      <h2 class="text-3xl font-bold text-text-primary mb-12 text-center">What We Can Create</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {[
          { title: 'Personalized Gifts', desc: 'Custom commemorative items, personalized keepsakes, and gifts' },
          { title: 'Corporate & Bulk Orders', desc: 'Custom branded merchandise, event gifts, and volume production' },
          { title: 'Prototypes & Models', desc: 'Functional prototypes for concept presentation and evaluation' },
          { title: 'Replacement & Custom Parts', desc: 'Tailored components and hard-to-find replacement pieces' },
          { title: 'Architectural & Scale Models', desc: 'Scale models for presentations, displays, and planning' },
          { title: 'Art & Bespoke Decor', desc: 'Original decor items, sculptures, and custom artistic creations' },
        ].map((item) => (
          <div class="p-6 bg-surface rounded-xl border border-border-subtle">
            <h3 class="text-lg font-semibold text-text-primary mb-2">{item.title}</h3>
            <p class="text-text-secondary text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Materials & Options -->
  <section class="py-20 bg-surface">
    <div class="container-page max-w-4xl">
      <h2 class="text-3xl font-bold text-text-primary mb-6 text-center">Quality Materials & Options</h2>
      <p class="text-center text-text-secondary mb-12 max-w-2xl mx-auto">
        We use premium materials and finishes tailored to the exact requirements of your project.
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="text-center p-6">
          <h3 class="font-semibold text-text-primary mb-2">Standard & Eco-Friendly</h3>
          <p class="text-sm text-text-secondary">Reliable everyday materials with clean surface finishes</p>
        </div>
        <div class="text-center p-6">
          <h3 class="font-semibold text-text-primary mb-2">High Durability</h3>
          <p class="text-sm text-text-secondary">Tough, impact-resistant options for long-lasting use</p>
        </div>
        <div class="text-center p-6">
          <h3 class="font-semibold text-text-primary mb-2">Specialty Finishes</h3>
          <p class="text-sm text-text-secondary">Textured, metallic, glossy, and custom color options</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-brand-600 text-white">
    <div class="container-page max-w-3xl text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to Get Started?</h2>
      <p class="text-lg text-brand-100 mb-10">
        Chat with us on WhatsApp to discuss your custom project. We typically respond within a few hours.
      </p>
      <Button href={getWhatsAppLink('Hi! I have a custom order request.')} variant="secondary" size="lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Start Your Custom Project
      </Button>
    </div>
  </section>
</Layout>
