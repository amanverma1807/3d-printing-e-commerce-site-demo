---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { siteConfig, getWhatsAppLink, hasWhatsApp, hasEmail, hasPhone, hasSocial } from '../config/site';
---

<Layout title={`Contact Us — ${siteConfig.brand.name}`}>
  <section class="py-20 bg-surface">
    <div class="container-page max-w-4xl">
      <h1 class="text-5xl font-bold text-text-primary mb-6 text-center">Get in Touch</h1>
      <p class="text-xl text-text-secondary text-center mb-16 max-w-2xl mx-auto">
        Have questions? Need help with an order? Want to discuss a custom project? We're here to help.
      </p>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-text-primary mb-6">Contact Information</h2>

            <div class="space-y-6">
              {hasPhone() && (
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-text-primary mb-1">Phone</h3>
                    <a href={`tel:${siteConfig.contact.phoneRaw || siteConfig.contact.phoneDisplay}`} class="text-text-secondary hover:text-brand-600 transition-colors font-mono">
                      {siteConfig.contact.phoneDisplay || siteConfig.contact.phoneRaw}
                    </a>
                  </div>
                </div>
              )}

              {hasEmail() && (
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m2 7 10 7 10-7"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-text-primary mb-1">Email</h3>
                    <a href={`mailto:${siteConfig.contact.email}`} class="text-text-secondary hover:text-brand-600 transition-colors font-mono">
                      {siteConfig.contact.email}
                    </a>
                  </div>
                </div>
              )}

              {hasWhatsApp() && (
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-text-primary mb-1">WhatsApp</h3>
                    <a href={getWhatsAppLink()} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-brand-600 transition-colors block mb-2 font-mono text-sm">
                      {siteConfig.contact.whatsappDisplay || siteConfig.contact.whatsapp}
                    </a>
                    <Button href={getWhatsAppLink()} target="_blank" rel="noopener noreferrer" size="sm" variant="outline">Start Chat</Button>
                  </div>
                </div>
              )}

              {hasSocial('instagram') && (
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                      <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-text-primary mb-1">Instagram</h3>
                    <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-brand-600 transition-colors block font-mono text-sm">
                      {siteConfig.social.instagramHandle}
                    </a>
                  </div>
                </div>
              )}

              {!hasPhone() && !hasEmail() && !hasWhatsApp() && !hasSocial('instagram') && (
                <p class="text-sm text-text-secondary">Direct contact information will be configured shortly.</p>
              )}
            </div>
          </div>

          {(siteConfig.businessHours.weekday || siteConfig.businessHours.weekend) && (
            <div class="pt-8 border-t border-border-subtle">
              <h3 class="font-semibold text-text-primary mb-4">Business Hours</h3>
              <div class="space-y-2 text-sm text-text-secondary">
                {siteConfig.businessHours.weekday && <p>{siteConfig.businessHours.weekday}</p>}
                {siteConfig.businessHours.weekend && <p>{siteConfig.businessHours.weekend}</p>}
              </div>
            </div>
          )}
        </div>

        <!-- Contact Form -->
        <div>
          <div class="mb-6 p-4 rounded-xl bg-surface-muted border border-border text-xs text-text-secondary">
            <div class="flex items-center gap-2 mb-1.5 font-semibold text-text-primary">
              <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
              <span>Template Placeholder</span>
            </div>
            <p class="leading-relaxed">
              Email backend integration is scheduled for Phase 3. Submitting this form displays a demonstration notice. To reach us directly, please use the contact details provided.
            </p>
          </div>

          <form id="contact-form" class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-text-primary mb-1.5">Name</label>
              <input
                type="text"
                id="name"
                required
                class="w-full px-4 py-3 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-sm font-medium text-text-primary mb-1.5">Email</label>
              <input
                type="email"
                id="contact-email"
                required
                class="w-full px-4 py-3 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent"
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-text-primary mb-1.5">Subject</label>
              <input
                type="text"
                id="subject"
                required
                class="w-full px-4 py-3 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent"
                placeholder="How can we help?"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-text-primary mb-1.5">Message</label>
              <textarea
                id="message"
                required
                rows="6"
                class="w-full px-4 py-3 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent resize-none"
                placeholder="Tell us more..."
              ></textarea>
            </div>

            <Button type="submit" size="lg" class="w-full">Send Message</Button>
            <div id="contact-status" class="hidden p-3 rounded-lg text-xs font-mono bg-stone-100 border border-border text-stone-700 text-center"></div>
            <p class="text-xs text-text-tertiary text-center">We typically respond within 1 business day.</p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactStatus = document.getElementById('contact-status');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (contactStatus) {
      contactStatus.textContent = 'Message captured! (Template Placeholder: Connect email service in Phase 3).';
      contactStatus.classList.remove('hidden');
    }
  });
</script>

