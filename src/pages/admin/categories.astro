---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Categories — E-commerce Admin" activeSection="categories">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-text-primary">Categories</h1>
      <p class="text-sm text-text-secondary mt-1">
        Manage product groupings, collection slugs, and display ordering.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <button
        id="add-category-btn"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl transition-all shadow-sm hover:shadow"
      >
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Add Category</span>
      </button>
    </div>
  </div>

  <!-- Alert Banner for notifications -->
  <div id="toast-banner" class="hidden mb-6 p-4 rounded-xl text-sm transition-all flex items-start justify-between gap-3 shadow-xs">
    <div class="flex items-start gap-3">
      <div id="toast-icon" class="mt-0.5 shrink-0"></div>
      <div id="toast-text" class="font-medium"></div>
    </div>
    <button id="toast-close" class="text-text-tertiary hover:text-text-primary">
      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Categories Table Container -->
  <div class="bg-surface-bright rounded-2xl border border-border shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-surface/50 border-b border-border text-[11px] font-semibold text-text-secondary uppercase tracking-wider">
            <th class="py-3.5 px-4 w-16 text-center">Thumbnail</th>
            <th class="py-3.5 px-4 w-16 text-center">Order</th>
            <th class="py-3.5 px-4">Category Name</th>
            <th class="py-3.5 px-4">Slug</th>
            <th class="py-3.5 px-4">Description</th>
            <th class="py-3.5 px-4 text-center">Products</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="categories-tbody" class="divide-y divide-border">
          <tr>
            <td colspan="7" class="py-12 text-center text-text-tertiary">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading categories from database...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden py-16 text-center">
      <div class="w-12 h-12 rounded-2xl bg-surface-muted text-text-tertiary mx-auto mb-3 flex items-center justify-center">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="font-semibold text-text-primary text-base">No categories found</h3>
      <p class="text-xs text-text-secondary mt-1 max-w-sm mx-auto mb-4">
        Add your first product category to organize your catalog.
      </p>
      <button
        type="button"
        id="empty-add-btn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 text-white text-xs font-semibold rounded-xl hover:bg-brand-700 transition-colors"
      >
        Add First Category
      </button>
    </div>
  </div>

  <!-- Add/Edit Category Modal -->
  <div id="category-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-surface-bright rounded-2xl max-w-md w-full border border-border shadow-2xl overflow-hidden animate-scale-in">
      <div class="p-6 border-b border-border flex items-center justify-between">
        <h3 id="modal-title" class="text-lg font-bold text-text-primary">Add Category</h3>
        <button id="close-modal-btn" type="button" class="p-1.5 text-text-tertiary hover:text-text-primary rounded-lg hover:bg-surface-muted transition-colors">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="category-form" class="p-6 space-y-4">
        <input type="hidden" id="category-id" value="" />

        <!-- Thumbnail Upload Section -->
        <div>
          <label class="block text-xs font-semibold text-text-primary mb-1.5">Category Thumbnail</label>
          <div class="flex items-center gap-4">
            <div id="cat-preview-box" class="w-16 h-16 rounded-xl border border-border overflow-hidden bg-surface-muted flex items-center justify-center shrink-0 relative">
              <img id="cat-preview-img" src="" alt="Thumbnail preview" class="w-full h-full object-cover hidden" />
              <div id="cat-placeholder-icon" class="text-text-tertiary">
                <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            </div>

            <div class="space-y-1.5 flex-1">
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="cat-upload-trigger"
                  class="px-3 py-1.5 text-xs font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded-lg border border-brand-200 transition-colors"
                >
                  Upload Image
                </button>
                <button
                  type="button"
                  id="cat-remove-img-btn"
                  class="hidden px-2.5 py-1.5 text-xs font-medium text-danger hover:bg-danger/10 rounded-lg transition-colors border border-danger/20"
                >
                  Remove
                </button>
              </div>
              <input type="file" id="cat-image-file" accept="image/jpeg,image/png,image/webp,image/svg+xml" class="hidden" />
              <p class="text-[11px] text-text-tertiary">JPG, PNG, WebP or SVG up to 5MB. Reuses product-images bucket.</p>
              <div id="cat-upload-status" class="hidden text-xs text-brand-600 font-medium">Uploading image...</div>
            </div>
          </div>
        </div>

        <div>
          <label for="category-name" class="block text-xs font-semibold text-text-primary mb-1">Category Name *</label>
          <input
            type="text"
            id="category-name"
            required
            placeholder="e.g. Home & Living"
            class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600"
          />
        </div>

        <div>
          <label for="category-slug" class="block text-xs font-semibold text-text-primary mb-1">
            URL Slug * <span class="text-text-tertiary font-normal">(auto-generated, lowercase & hyphens)</span>
          </label>
          <input
            type="text"
            id="category-slug"
            required
            placeholder="e.g. home-living"
            class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600 font-mono text-xs"
          />
        </div>

        <div>
          <label for="category-order" class="block text-xs font-semibold text-text-primary mb-1">Display Order</label>
          <input
            type="number"
            id="category-order"
            value="0"
            class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600"
          />
        </div>

        <div>
          <label for="category-desc" class="block text-xs font-semibold text-text-primary mb-1">Description</label>
          <textarea
            id="category-desc"
            rows="2"
            placeholder="Short description for collection cards"
            class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600 resize-none"
          ></textarea>
        </div>

        <div id="modal-error" class="hidden text-xs text-danger p-3 rounded-lg bg-danger/10 border border-danger/20 font-medium"></div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button
            type="button"
            id="cancel-modal-btn"
            class="px-4 py-2.5 text-xs font-semibold text-text-secondary hover:bg-surface-muted rounded-xl transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="save-category-btn"
            class="px-5 py-2.5 text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white rounded-xl transition-all shadow-sm flex items-center gap-2"
          >
            <span id="save-text">Save Category</span>
            <svg id="save-spinner" class="hidden animate-spin w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-surface-bright rounded-2xl max-w-sm w-full border border-border shadow-2xl p-6 text-center animate-scale-in">
      <div class="w-12 h-12 rounded-2xl bg-danger/10 text-danger mx-auto mb-4 flex items-center justify-center">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-text-primary mb-1">Delete Category</h3>
      <p id="delete-modal-msg" class="text-xs text-text-secondary mb-6">
        Are you sure you want to delete this category? This action cannot be undone.
      </p>

      <div class="flex items-center justify-center gap-3">
        <button
          type="button"
          id="cancel-delete-btn"
          class="px-4 py-2 text-xs font-semibold text-text-secondary hover:bg-surface-muted rounded-xl transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-delete-btn"
          class="px-4 py-2 text-xs font-semibold bg-danger hover:bg-danger/90 text-white rounded-xl transition-colors shadow-sm"
        >
          Delete Permanently
        </button>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    interface CategoryRow {
      id: string;
      name: string;
      slug: string;
      description: string | null;
      image_url: string | null;
      display_order: number;
      product_count?: number;
    }

    let categories: CategoryRow[] = [];
    let deleteTargetId: string | null = null;
    let deleteTargetCat: CategoryRow | null = null;
    let isSlugManual = false;
    let currentImageUrl: string | null = null;
    let originalImageUrl: string | null = null;

    // Elements
    const tbody = document.getElementById('categories-tbody');
    const emptyState = document.getElementById('empty-state');
    const toast = document.getElementById('toast-banner');
    const toastText = document.getElementById('toast-text');
    const toastIcon = document.getElementById('toast-icon');
    const toastClose = document.getElementById('toast-close');

    const modal = document.getElementById('category-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalError = document.getElementById('modal-error');
    const form = document.getElementById('category-form') as HTMLFormElement;
    const catIdInput = document.getElementById('category-id') as HTMLInputElement;
    const catNameInput = document.getElementById('category-name') as HTMLInputElement;
    const catSlugInput = document.getElementById('category-slug') as HTMLInputElement;
    const catOrderInput = document.getElementById('category-order') as HTMLInputElement;
    const catDescInput = document.getElementById('category-desc') as HTMLTextAreaElement;
    const saveBtn = document.getElementById('save-category-btn') as HTMLButtonElement;
    const saveText = document.getElementById('save-text') as HTMLSpanElement;
    const saveSpinner = document.getElementById('save-spinner') as HTMLElement;

    // Image Upload Elements
    const catPreviewImg = document.getElementById('cat-preview-img') as HTMLImageElement;
    const catPlaceholderIcon = document.getElementById('cat-placeholder-icon');
    const catUploadTrigger = document.getElementById('cat-upload-trigger');
    const catRemoveImgBtn = document.getElementById('cat-remove-img-btn');
    const catImageFile = document.getElementById('cat-image-file') as HTMLInputElement;
    const catUploadStatus = document.getElementById('cat-upload-status');

    const deleteModal = document.getElementById('delete-modal');
    const deleteModalMsg = document.getElementById('delete-modal-msg');
    const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
    const confirmDeleteBtn = document.getElementById('confirm-delete-btn');

    // Helper: update image preview UI
    function updateImagePreview(url: string | null) {
      currentImageUrl = url;
      if (url) {
        if (catPreviewImg) {
          catPreviewImg.src = url;
          catPreviewImg.classList.remove('hidden');
        }
        if (catPlaceholderIcon) catPlaceholderIcon.classList.add('hidden');
        if (catRemoveImgBtn) catRemoveImgBtn.classList.remove('hidden');
        if (catUploadTrigger) catUploadTrigger.textContent = 'Change Image';
      } else {
        if (catPreviewImg) {
          catPreviewImg.src = '';
          catPreviewImg.classList.add('hidden');
        }
        if (catPlaceholderIcon) catPlaceholderIcon.classList.remove('hidden');
        if (catRemoveImgBtn) catRemoveImgBtn.classList.add('hidden');
        if (catUploadTrigger) catUploadTrigger.textContent = 'Upload Image';
      }
    }

    // Storage file cleanup helper
    async function cleanStorageFile(url: string | null) {
      if (!url) return;
      try {
        const marker = '/product-images/';
        const idx = url.indexOf(marker);
        if (idx !== -1) {
          const filePath = url.substring(idx + marker.length).split('?')[0];
          if (filePath) {
            await supabase.storage.from('product-images').remove([filePath]);
          }
        }
      } catch (err) {
        console.warn('Storage cleanup notice:', err);
      }
    }

    // Trigger file picker
    catUploadTrigger?.addEventListener('click', () => {
      catImageFile?.click();
    });

    // Remove image button
    catRemoveImgBtn?.addEventListener('click', () => {
      updateImagePreview(null);
    });

    // Upload image to Supabase Storage
    catImageFile?.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;

      // 5MB limit validation
      if (file.size > 5 * 1024 * 1024) {
        showToast(`File "${file.name}" exceeds the 5MB size limit.`, true);
        target.value = '';
        return;
      }

      // Format validation
      const ext = file.name.split('.').pop()?.toLowerCase();
      if (!['jpg', 'jpeg', 'png', 'webp', 'svg'].includes(ext || '')) {
        showToast(`Unsupported format for "${file.name}". Please use JPG, PNG, WebP or SVG.`, true);
        target.value = '';
        return;
      }

      if (catUploadStatus) catUploadStatus.classList.remove('hidden');

      try {
        const safeName = `store_cat_${Date.now()}_${Math.random().toString(36).substring(2, 7)}.${ext}`;
        const filePath = `categories/${safeName}`;

        const { error: uploadError } = await supabase.storage
          .from('product-images')
          .upload(filePath, file, {
            cacheControl: '3600',
            upsert: false,
          });

        if (uploadError) {
          showToast(`Upload failed: ${uploadError.message}`, true);
          return;
        }

        const { data: { publicUrl } } = supabase.storage
          .from('product-images')
          .getPublicUrl(filePath);

        if (publicUrl) {
          updateImagePreview(publicUrl);
          showToast('Category thumbnail uploaded.');
        }
      } catch (err: any) {
        showToast('Storage upload error: ' + (err?.message || 'Failed'), true);
      } finally {
        if (catUploadStatus) catUploadStatus.classList.add('hidden');
        target.value = '';
      }
    });

    // Auto-generate slug helper
    function slugify(text: string): string {
      return text
        .toString()
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
    }

    catNameInput?.addEventListener('input', () => {
      if (!isSlugManual && (!catIdInput.value || catSlugInput.value === '')) {
        catSlugInput.value = slugify(catNameInput.value);
      }
    });

    catSlugInput?.addEventListener('input', () => {
      isSlugManual = true;
    });

    // Prevent accidental form submission on Enter in normal inputs
    form?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'TEXTAREA') {
        e.preventDefault();
      }
    });

    function showToast(message: string, isError = false) {
      if (!toast || !toastText || !toastIcon) return;
      toastText.textContent = message;
      if (isError) {
        toast.className = 'mb-6 p-4 rounded-xl text-sm flex items-start justify-between gap-3 shadow-xs bg-danger/10 border border-danger/20 text-danger';
        toastIcon.innerHTML = `<svg class="w-5 h-5 text-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/></svg>`;
      } else {
        toast.className = 'mb-6 p-4 rounded-xl text-sm flex items-start justify-between gap-3 shadow-xs bg-success/10 border border-success/20 text-success';
        toastIcon.innerHTML = `<svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      }
      toast.classList.remove('hidden');
    }

    toastClose?.addEventListener('click', () => {
      toast?.classList.add('hidden');
    });

    // Load Categories from Supabase
    async function loadCategories() {
      try {
        const { data, error } = await supabase
          .from('categories')
          .select(`
            id,
            name,
            slug,
            description,
            image_url,
            display_order
          `)
          .order('display_order', { ascending: true });

        if (error) {
          showToast('Failed to load categories: ' + error.message, true);
          return;
        }

        // Fetch product counts per category
        const { data: productGroup } = await supabase
          .from('products')
          .select('category_id');

        const countsMap: Record<string, number> = {};
        (productGroup || []).forEach((p: any) => {
          if (p.category_id) {
            countsMap[p.category_id] = (countsMap[p.category_id] || 0) + 1;
          }
        });

        categories = (data || []).map(cat => ({
          ...cat,
          product_count: countsMap[cat.id] || 0,
        }));

        renderTable();
      } catch (err: any) {
        showToast('Error loading categories: ' + (err?.message || 'Network error'), true);
      }
    }

    function renderTable() {
      if (!tbody || !emptyState) return;

      if (categories.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      tbody.innerHTML = categories.map(cat => `
        <tr class="hover:bg-surface/30 transition-colors">
          <td class="py-2.5 px-4 text-center">
            ${cat.image_url ? `
              <img src="${cat.image_url}" alt="${cat.name}" class="w-10 h-10 rounded-lg object-cover mx-auto border border-border bg-surface" />
            ` : `
              <div class="w-10 h-10 rounded-lg bg-surface-muted border border-border flex items-center justify-center text-text-tertiary mx-auto">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            `}
          </td>
          <td class="py-3 px-4 text-center font-mono text-xs font-semibold text-text-tertiary">
            ${cat.display_order}
          </td>
          <td class="py-3 px-4">
            <span class="font-semibold text-text-primary">${cat.name}</span>
          </td>
          <td class="py-3 px-4 font-mono text-xs text-brand-700">
            /${cat.slug}
          </td>
          <td class="py-3 px-4 text-xs text-text-secondary max-w-xs truncate">
            ${cat.description || '<span class="text-text-tertiary">No description</span>'}
          </td>
          <td class="py-3 px-4 text-center">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${
              cat.product_count && cat.product_count > 0
                ? 'bg-brand-100 text-brand-700'
                : 'bg-surface-muted text-text-tertiary'
            }">
              ${cat.product_count || 0}
            </span>
          </td>
          <td class="py-3 px-4 text-right">
            <div class="inline-flex items-center gap-1.5">
              <button
                type="button"
                data-edit-id="${cat.id}"
                class="edit-cat-btn px-2.5 py-1 text-xs font-medium text-brand-600 hover:text-brand-700 hover:bg-brand-50 rounded-lg transition-colors border border-brand-200"
              >
                Edit
              </button>
              <button
                type="button"
                data-delete-id="${cat.id}"
                class="delete-cat-btn px-2.5 py-1 text-xs font-medium text-danger hover:text-white hover:bg-danger rounded-lg transition-colors border border-danger/30"
              >
                Delete
              </button>
            </div>
          </td>
        </tr>
      `).join('');

      // Attach event listeners
      document.querySelectorAll('.edit-cat-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-edit-id');
          const cat = categories.find(c => c.id === id);
          if (cat) openModal(cat);
        });
      });

      document.querySelectorAll('.delete-cat-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-delete-id');
          const cat = categories.find(c => c.id === id);
          if (cat) handleDeleteClick(cat);
        });
      });
    }

    function openModal(cat?: CategoryRow) {
      if (!modal) return;
      isSlugManual = Boolean(cat);
      if (modalError) modalError.classList.add('hidden');

      if (cat) {
        if (modalTitle) modalTitle.textContent = 'Edit Category';
        catIdInput.value = cat.id;
        catNameInput.value = cat.name;
        catSlugInput.value = cat.slug;
        catOrderInput.value = cat.display_order.toString();
        catDescInput.value = cat.description || '';
        originalImageUrl = cat.image_url || null;
        updateImagePreview(cat.image_url || null);
      } else {
        if (modalTitle) modalTitle.textContent = 'Add Category';
        catIdInput.value = '';
        catNameInput.value = '';
        catSlugInput.value = '';
        catOrderInput.value = (categories.length + 1).toString();
        catDescInput.value = '';
        originalImageUrl = null;
        updateImagePreview(null);
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      catNameInput.focus();
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // Modal submit handler (Add / Edit)
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (modalError) modalError.classList.add('hidden');

      const id = catIdInput.value;
      const name = catNameInput.value.trim();
      const slug = slugify(catSlugInput.value.trim());
      const displayOrder = parseInt(catOrderInput.value) || 0;
      const description = catDescInput.value.trim() || null;

      if (!name || !slug) {
        if (modalError) {
          modalError.textContent = 'Name and Slug are required.';
          modalError.classList.remove('hidden');
        }
        return;
      }

      // Check client-side duplicate slug among existing categories (except current)
      const duplicate = categories.find(c => c.slug === slug && c.id !== id);
      if (duplicate) {
        if (modalError) {
          modalError.textContent = `Slug "${slug}" is already in use by "${duplicate.name}". Please choose a unique slug.`;
          modalError.classList.remove('hidden');
        }
        return;
      }

      // Set saving state
      saveBtn.disabled = true;
      saveText.textContent = 'Saving...';
      saveSpinner.classList.remove('hidden');

      try {
        if (id) {
          // Update
          const { error } = await supabase
            .from('categories')
            .update({
              name,
              slug,
              description,
              image_url: currentImageUrl,
              display_order: displayOrder,
            })
            .eq('id', id);

          if (error) throw error;

          // If image was replaced or removed, safely clean up old file from storage
          if (originalImageUrl && originalImageUrl !== currentImageUrl) {
            await cleanStorageFile(originalImageUrl);
          }

          showToast(`Category "${name}" updated successfully.`);
        } else {
          // Insert
          const { error } = await supabase
            .from('categories')
            .insert({
              name,
              slug,
              description,
              image_url: currentImageUrl,
              display_order: displayOrder,
            });

          if (error) throw error;
          showToast(`Category "${name}" created successfully.`);
        }

        closeModal();
        await loadCategories();
      } catch (err: any) {
        if (modalError) {
          if (err?.code === '23505' || err?.message?.includes('duplicate key')) {
            modalError.textContent = `A category with the slug "${slug}" already exists. Please choose a different slug.`;
          } else {
            modalError.textContent = err?.message || 'Failed to save category. Please check your admin privileges.';
          }
          modalError.classList.remove('hidden');
        }
      } finally {
        saveBtn.disabled = false;
        saveText.textContent = 'Save Category';
        saveSpinner.classList.add('hidden');
      }
    });

    // Delete handling with association check
    async function handleDeleteClick(cat: CategoryRow) {
      deleteTargetId = cat.id;
      deleteTargetCat = cat;

      // 1. Verify associated products
      if (cat.product_count && cat.product_count > 0) {
        showToast(
          `Cannot delete "${cat.name}". It is associated with ${cat.product_count} product(s). Please reassign or delete these products first.`,
          true
        );
        return;
      }

      // 2. Double check directly against database
      const { count, error } = await supabase
        .from('products')
        .select('id', { count: 'exact', head: true })
        .eq('category_id', cat.id);

      if (!error && count && count > 0) {
        showToast(
          `Cannot delete "${cat.name}". It has ${count} product(s) linked in the database. Please reassign those products first.`,
          true
        );
        return;
      }

      // 3. Show confirmation modal
      if (deleteModalMsg) {
        deleteModalMsg.textContent = `Are you sure you want to delete the category "${cat.name}"? This cannot be undone.`;
      }
      if (deleteModal) {
        deleteModal.classList.remove('hidden');
        deleteModal.classList.add('flex');
      }
    }

    confirmDeleteBtn?.addEventListener('click', async () => {
      if (!deleteTargetId) return;

      try {
        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.textContent = 'Deleting...';

        const { error } = await supabase
          .from('categories')
          .delete()
          .eq('id', deleteTargetId);

        if (error) throw error;

        // Clean up storage image if present
        if (deleteTargetCat?.image_url) {
          await cleanStorageFile(deleteTargetCat.image_url);
        }

        showToast('Category deleted successfully.');
        if (deleteModal) {
          deleteModal.classList.add('hidden');
          deleteModal.classList.remove('flex');
        }
        await loadCategories();
      } catch (err: any) {
        showToast('Failed to delete category: ' + (err?.message || 'Database constraint error'), true);
      } finally {
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = 'Delete Permanently';
        deleteTargetId = null;
        deleteTargetCat = null;
      }
    });

    cancelDeleteBtn?.addEventListener('click', () => {
      if (deleteModal) {
        deleteModal.classList.add('hidden');
        deleteModal.classList.remove('flex');
      }
      deleteTargetId = null;
      deleteTargetCat = null;
    });

    document.getElementById('add-category-btn')?.addEventListener('click', () => openModal());
    document.getElementById('empty-add-btn')?.addEventListener('click', () => openModal());
    document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
    document.getElementById('cancel-modal-btn')?.addEventListener('click', closeModal);

    // Initial load when admin authentication is confirmed
    window.addEventListener('template:admin-ready', () => {
      loadCategories();
    });
  </script>
</AdminLayout>
