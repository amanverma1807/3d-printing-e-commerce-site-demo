---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Hero Slides" activeSection="hero">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-text-primary">Hero Carousel Slides</h1>
      <p class="text-sm text-text-secondary mt-1">
        Manage the visual slides, synchronized copy, and call-to-action buttons on the storefront homepage.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <button
        id="add-slide-btn"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl transition-all shadow-sm hover:shadow cursor-pointer"
      >
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Add Slide</span>
      </button>
    </div>
  </div>

  <!-- Alert Banner for notifications -->
  <div id="toast-banner" class="hidden mb-6 p-4 rounded-xl text-sm transition-all flex items-start justify-between gap-3 shadow-xs">
    <div class="flex items-start gap-3">
      <div id="toast-icon" class="mt-0.5 shrink-0"></div>
      <div id="toast-text" class="font-medium"></div>
    </div>
    <button id="toast-close" class="text-text-tertiary hover:text-text-primary">
      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Slides Table Container -->
  <div class="bg-surface-bright rounded-2xl border border-border shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-surface/50 border-b border-border text-[11px] font-semibold text-text-secondary uppercase tracking-wider">
            <th class="py-3.5 px-4 w-14 text-center">Order</th>
            <th class="py-3.5 px-4 w-28">Preview</th>
            <th class="py-3.5 px-4">Heading & Description</th>
            <th class="py-3.5 px-4">CTAs</th>
            <th class="py-3.5 px-4 text-center w-24">Status</th>
            <th class="py-3.5 px-4 text-right w-32">Actions</th>
          </tr>
        </thead>
        <tbody id="slides-tbody" class="divide-y divide-border">
          <tr>
            <td colspan="6" class="py-12 text-center text-text-tertiary">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading hero slides from database...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden py-16 text-center">
      <div class="w-12 h-12 rounded-2xl bg-surface-muted text-text-tertiary mx-auto mb-3 flex items-center justify-center">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h3 class="font-semibold text-text-primary text-base">No hero slides found</h3>
      <p class="text-xs text-text-secondary mt-1 max-w-sm mx-auto mb-4">
        Add your first hero carousel slide to showcase on the homepage.
      </p>
      <button
        type="button"
        id="empty-add-btn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 text-white text-xs font-semibold rounded-xl hover:bg-brand-700 transition-colors cursor-pointer"
      >
        Add First Slide
      </button>
    </div>
  </div>

  <!-- Add/Edit Slide Modal -->
  <div id="slide-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4 overflow-y-auto">
    <div class="bg-surface-bright rounded-2xl max-w-lg w-full border border-border shadow-2xl overflow-hidden animate-scale-in my-8">
      <div class="p-6 border-b border-border flex items-center justify-between">
        <h3 id="modal-title" class="text-lg font-bold text-text-primary">Add Hero Slide</h3>
        <button id="close-modal-btn" type="button" class="p-1.5 text-text-tertiary hover:text-text-primary rounded-lg hover:bg-surface-muted transition-colors cursor-pointer">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="slide-form" class="p-6 space-y-4">
        <input type="hidden" id="slide-id" value="" />

        <!-- Image Upload Field -->
        <div>
          <label class="block text-xs font-semibold text-text-primary mb-1.5">Slide Image *</label>
          <div class="space-y-3">
            <div id="slide-preview-box" class="w-full h-44 rounded-xl border border-border overflow-hidden bg-surface-muted flex items-center justify-center relative group">
              <img id="slide-preview-img" src="" alt="Slide preview" class="w-full h-full object-cover hidden" />
              <div id="slide-placeholder-icon" class="text-center p-4">
                <svg class="w-8 h-8 text-text-tertiary mx-auto mb-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-xs text-text-tertiary">No image selected</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <button
                type="button"
                id="slide-upload-trigger"
                class="px-3.5 py-2 text-xs font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded-lg border border-brand-200 transition-colors cursor-pointer"
              >
                Upload / Choose Image
              </button>
              <button
                type="button"
                id="slide-remove-img-btn"
                class="hidden px-3 py-2 text-xs font-medium text-danger hover:bg-danger/10 rounded-lg transition-colors border border-danger/20 cursor-pointer"
              >
                Remove Image
              </button>
              <span id="slide-upload-status" class="hidden text-xs text-brand-600 font-medium">Uploading to storage...</span>
            </div>
            <input type="file" id="slide-image-file" accept="image/jpeg,image/png,image/webp,image/svg+xml" class="hidden" />
            <p class="text-[11px] text-text-tertiary">Recommended: High-res landscape (1920x1080). JPG, PNG, WebP up to 5MB.</p>
          </div>
        </div>

        <!-- Heading -->
        <div>
          <label for="slide-heading" class="block text-xs font-semibold text-text-primary mb-1">Slide Heading *</label>
          <input
            type="text"
            id="slide-heading"
            required
            placeholder="e.g. Crafted to Perfection. Designed to Stand Out."
            class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600"
          />
        </div>

        <!-- Description -->
        <div>
          <label for="slide-description" class="block text-xs font-semibold text-text-primary mb-1">Description / Subtitle</label>
          <textarea
            id="slide-description"
            rows="2"
            placeholder="e.g. Carefully curated essentials designed to elevate your everyday spaces."
            class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600 resize-none"
          ></textarea>
        </div>

        <!-- Primary CTA Group -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="slide-primary-cta-text" class="block text-xs font-semibold text-text-primary mb-1">Primary Button Text</label>
            <input
              type="text"
              id="slide-primary-cta-text"
              placeholder="e.g. Shop Collection"
              class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600"
            />
          </div>
          <div>
            <label for="slide-primary-cta-link" class="block text-xs font-semibold text-text-primary mb-1">Primary Button Link</label>
            <input
              type="text"
              id="slide-primary-cta-link"
              placeholder="e.g. /shop"
              class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600 font-mono text-xs"
            />
          </div>
        </div>

        <!-- Secondary CTA Group -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="slide-secondary-cta-text" class="block text-xs font-semibold text-text-primary mb-1">Secondary Button Text</label>
            <input
              type="text"
              id="slide-secondary-cta-text"
              placeholder="e.g. Custom Orders"
              class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600"
            />
          </div>
          <div>
            <label for="slide-secondary-cta-link" class="block text-xs font-semibold text-text-primary mb-1">Secondary Button Link</label>
            <input
              type="text"
              id="slide-secondary-cta-link"
              placeholder="e.g. /custom"
              class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600 font-mono text-xs"
            />
          </div>
        </div>

        <!-- Display Order & Active Toggle -->
        <div class="grid grid-cols-2 gap-4 items-center pt-2">
          <div>
            <label for="slide-order" class="block text-xs font-semibold text-text-primary mb-1">Display Order</label>
            <input
              type="number"
              id="slide-order"
              value="1"
              class="w-full px-3.5 py-2.5 bg-surface text-sm rounded-xl border border-border focus:outline-none focus:ring-2 focus:ring-brand-600"
            />
          </div>

          <div class="pt-5">
            <label class="flex items-center gap-2.5 cursor-pointer">
              <input
                type="checkbox"
                id="slide-is-active"
                checked
                class="w-4 h-4 rounded text-brand-600 focus:ring-brand-600 border-border"
              />
              <span class="text-xs font-semibold text-text-primary">Active on Storefront</span>
            </label>
          </div>
        </div>

        <div id="modal-error" class="hidden text-xs text-danger p-3 rounded-lg bg-danger/10 border border-danger/20 font-medium"></div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button
            type="button"
            id="cancel-modal-btn"
            class="px-4 py-2.5 text-xs font-semibold text-text-secondary hover:bg-surface-muted rounded-xl transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="save-slide-btn"
            class="px-5 py-2.5 text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white rounded-xl transition-all shadow-sm flex items-center gap-2 cursor-pointer"
          >
            <span id="save-text">Save Slide</span>
            <svg id="save-spinner" class="hidden animate-spin w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-surface-bright rounded-2xl max-w-sm w-full border border-border shadow-2xl p-6 text-center animate-scale-in">
      <div class="w-12 h-12 rounded-2xl bg-danger/10 text-danger mx-auto mb-4 flex items-center justify-center">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-text-primary mb-1">Delete Hero Slide</h3>
      <p id="delete-modal-msg" class="text-xs text-text-secondary mb-6">
        Are you sure you want to delete this hero slide? This action cannot be undone.
      </p>

      <div class="flex items-center justify-center gap-3">
        <button
          type="button"
          id="cancel-delete-btn"
          class="px-4 py-2 text-xs font-semibold text-text-secondary hover:bg-surface-muted rounded-xl transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-delete-btn"
          class="px-4 py-2 text-xs font-semibold bg-danger hover:bg-danger/90 text-white rounded-xl transition-colors shadow-sm cursor-pointer"
        >
          Delete Permanently
        </button>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';
    import type { DbHeroSlide } from '../../lib/catalog';

    let slides: DbHeroSlide[] = [];
    let deleteTargetId: string | null = null;
    let deleteTargetSlide: DbHeroSlide | null = null;
    let currentImageUrl: string | null = null;
    let originalImageUrl: string | null = null;

    // Elements
    const tbody = document.getElementById('slides-tbody');
    const emptyState = document.getElementById('empty-state');
    const toast = document.getElementById('toast-banner');
    const toastText = document.getElementById('toast-text');
    const toastIcon = document.getElementById('toast-icon');
    const toastClose = document.getElementById('toast-close');

    const modal = document.getElementById('slide-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalError = document.getElementById('modal-error');
    const form = document.getElementById('slide-form') as HTMLFormElement;
    const slideIdInput = document.getElementById('slide-id') as HTMLInputElement;
    const slideHeadingInput = document.getElementById('slide-heading') as HTMLInputElement;
    const slideDescInput = document.getElementById('slide-description') as HTMLTextAreaElement;
    const slidePrimaryText = document.getElementById('slide-primary-cta-text') as HTMLInputElement;
    const slidePrimaryLink = document.getElementById('slide-primary-cta-link') as HTMLInputElement;
    const slideSecondaryText = document.getElementById('slide-secondary-cta-text') as HTMLInputElement;
    const slideSecondaryLink = document.getElementById('slide-secondary-cta-link') as HTMLInputElement;
    const slideOrderInput = document.getElementById('slide-order') as HTMLInputElement;
    const slideIsActive = document.getElementById('slide-is-active') as HTMLInputElement;
    const saveBtn = document.getElementById('save-slide-btn') as HTMLButtonElement;
    const saveText = document.getElementById('save-text') as HTMLSpanElement;
    const saveSpinner = document.getElementById('save-spinner') as HTMLElement;

    // Image Upload Elements
    const slidePreviewImg = document.getElementById('slide-preview-img') as HTMLImageElement;
    const slidePlaceholderIcon = document.getElementById('slide-placeholder-icon');
    const slideUploadTrigger = document.getElementById('slide-upload-trigger');
    const slideRemoveImgBtn = document.getElementById('slide-remove-img-btn');
    const slideImageFile = document.getElementById('slide-image-file') as HTMLInputElement;
    const slideUploadStatus = document.getElementById('slide-upload-status');

    const deleteModal = document.getElementById('delete-modal');
    const deleteModalMsg = document.getElementById('delete-modal-msg');
    const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
    const confirmDeleteBtn = document.getElementById('confirm-delete-btn');

    // Helper: update image preview UI
    function updateImagePreview(url: string | null) {
      currentImageUrl = url;
      if (url) {
        if (slidePreviewImg) {
          slidePreviewImg.src = url;
          slidePreviewImg.classList.remove('hidden');
        }
        if (slidePlaceholderIcon) slidePlaceholderIcon.classList.add('hidden');
        if (slideRemoveImgBtn) slideRemoveImgBtn.classList.remove('hidden');
        if (slideUploadTrigger) slideUploadTrigger.textContent = 'Replace Image';
      } else {
        if (slidePreviewImg) {
          slidePreviewImg.src = '';
          slidePreviewImg.classList.add('hidden');
        }
        if (slidePlaceholderIcon) slidePlaceholderIcon.classList.remove('hidden');
        if (slideRemoveImgBtn) slideRemoveImgBtn.classList.add('hidden');
        if (slideUploadTrigger) slideUploadTrigger.textContent = 'Upload / Choose Image';
      }
    }

    // Storage file cleanup helper
    async function cleanStorageFile(url: string | null) {
      if (!url) return;
      try {
        const marker = '/product-images/';
        const idx = url.indexOf(marker);
        if (idx !== -1) {
          const filePath = url.substring(idx + marker.length).split('?')[0];
          if (filePath) {
            await supabase.storage.from('product-images').remove([filePath]);
          }
        }
      } catch (err) {
        console.warn('Storage cleanup notice:', err);
      }
    }

    // Trigger file picker
    slideUploadTrigger?.addEventListener('click', () => {
      slideImageFile?.click();
    });

    // Remove image button
    slideRemoveImgBtn?.addEventListener('click', () => {
      updateImagePreview(null);
    });

    // Upload image to Supabase Storage
    slideImageFile?.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        showToast(`File "${file.name}" exceeds the 5MB size limit.`, true);
        target.value = '';
        return;
      }

      const ext = file.name.split('.').pop()?.toLowerCase();
      if (!['jpg', 'jpeg', 'png', 'webp', 'svg'].includes(ext || '')) {
        showToast(`Unsupported format for "${file.name}". Please use JPG, PNG, WebP or SVG.`, true);
        target.value = '';
        return;
      }

      if (slideUploadStatus) slideUploadStatus.classList.remove('hidden');

      try {
        const safeName = `store_hero_${Date.now()}_${Math.random().toString(36).substring(2, 7)}.${ext}`;
        const filePath = `hero/${safeName}`;

        const { error: uploadError } = await supabase.storage
          .from('product-images')
          .upload(filePath, file, {
            cacheControl: '3600',
            upsert: false,
          });

        if (uploadError) {
          showToast(`Upload failed: ${uploadError.message}`, true);
          return;
        }

        const { data: { publicUrl } } = supabase.storage
          .from('product-images')
          .getPublicUrl(filePath);

        if (publicUrl) {
          updateImagePreview(publicUrl);
          showToast('Hero image uploaded successfully.');
        }
      } catch (err: any) {
        showToast('Storage error: ' + (err?.message || 'Failed'), true);
      } finally {
        if (slideUploadStatus) slideUploadStatus.classList.add('hidden');
        target.value = '';
      }
    });

    // Prevent accidental form submission on Enter in normal inputs
    form?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'TEXTAREA') {
        e.preventDefault();
      }
    });

    function showToast(message: string, isError = false) {
      if (!toast || !toastText || !toastIcon) return;
      toastText.textContent = message;
      if (isError) {
        toast.className = 'mb-6 p-4 rounded-xl text-sm flex items-start justify-between gap-3 shadow-xs bg-danger/10 border border-danger/20 text-danger';
        toastIcon.innerHTML = `<svg class="w-5 h-5 text-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/></svg>`;
      } else {
        toast.className = 'mb-6 p-4 rounded-xl text-sm flex items-start justify-between gap-3 shadow-xs bg-success/10 border border-success/20 text-success';
        toastIcon.innerHTML = `<svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      }
      toast.classList.remove('hidden');
    }

    toastClose?.addEventListener('click', () => {
      toast?.classList.add('hidden');
    });

    // Load Slides from Supabase
    async function loadSlides() {
      try {
        const { data, error } = await supabase
          .from('hero_slides')
          .select('*')
          .order('display_order', { ascending: true });

        if (error) {
          showToast('Failed to load hero slides: ' + error.message, true);
          return;
        }

        slides = (data || []) as DbHeroSlide[];
        renderTable();
      } catch (err: any) {
        showToast('Error loading slides: ' + (err?.message || 'Network error'), true);
      }
    }

    function renderTable() {
      if (!tbody || !emptyState) return;

      if (slides.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      tbody.innerHTML = slides.map(slide => `
        <tr class="hover:bg-surface/30 transition-colors">
          <td class="py-3 px-4 text-center font-mono text-xs font-semibold text-text-tertiary">
            ${slide.display_order}
          </td>
          <td class="py-3 px-4">
            <div class="w-24 h-14 rounded-lg overflow-hidden border border-border bg-surface-muted relative group">
              <img src="${slide.image_url}" alt="${slide.heading || 'Slide'}" class="w-full h-full object-cover" />
            </div>
          </td>
          <td class="py-3 px-4 max-w-sm">
            <div class="font-semibold text-text-primary text-sm mb-0.5 line-clamp-1">${slide.heading || 'Untitled Slide'}</div>
            <div class="text-xs text-text-secondary line-clamp-2">${slide.description || '<span class="text-text-tertiary">No description</span>'}</div>
          </td>
          <td class="py-3 px-4 text-xs">
            <div class="space-y-1">
              ${slide.primary_cta_text ? `
                <div class="flex items-center gap-1.5 font-medium text-brand-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-600"></span>
                  <span>${slide.primary_cta_text}</span>
                  <span class="font-mono text-[10px] text-text-tertiary">(${slide.primary_cta_link || '/shop'})</span>
                </div>
              ` : '<span class="text-text-tertiary">No primary CTA</span>'}
              ${slide.secondary_cta_text ? `
                <div class="flex items-center gap-1.5 text-text-secondary text-[11px]">
                  <span class="w-1.5 h-1.5 rounded-full bg-border"></span>
                  <span>${slide.secondary_cta_text}</span>
                  <span class="font-mono text-[10px] text-text-tertiary">(${slide.secondary_cta_link || '/custom'})</span>
                </div>
              ` : ''}
            </div>
          </td>
          <td class="py-3 px-4 text-center">
            <button
              type="button"
              data-toggle-id="${slide.id}"
              data-current-active="${slide.is_active}"
              class="toggle-active-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer ${
                slide.is_active
                  ? 'bg-success/15 text-success hover:bg-success/25'
                  : 'bg-surface-muted text-text-tertiary hover:bg-border'
              }"
              title="Click to toggle visibility"
            >
              <span class="w-1.5 h-1.5 rounded-full ${slide.is_active ? 'bg-success' : 'bg-text-tertiary'}"></span>
              <span>${slide.is_active ? 'Active' : 'Inactive'}</span>
            </button>
          </td>
          <td class="py-3 px-4 text-right">
            <div class="inline-flex items-center gap-1.5">
              <button
                type="button"
                data-edit-id="${slide.id}"
                class="edit-slide-btn px-2.5 py-1 text-xs font-medium text-brand-600 hover:text-brand-700 hover:bg-brand-50 rounded-lg transition-colors border border-brand-200 cursor-pointer"
              >
                Edit
              </button>
              <button
                type="button"
                data-delete-id="${slide.id}"
                class="delete-slide-btn px-2.5 py-1 text-xs font-medium text-danger hover:text-white hover:bg-danger rounded-lg transition-colors border border-danger/30 cursor-pointer"
              >
                Delete
              </button>
            </div>
          </td>
        </tr>
      `).join('');

      // Event Listeners
      document.querySelectorAll('.edit-slide-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-edit-id');
          const slide = slides.find(s => s.id === id);
          if (slide) openModal(slide);
        });
      });

      document.querySelectorAll('.delete-slide-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-delete-id');
          const slide = slides.find(s => s.id === id);
          if (slide) handleDeleteClick(slide);
        });
      });

      document.querySelectorAll('.toggle-active-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const button = e.currentTarget as HTMLElement;
          const id = button.getAttribute('data-toggle-id');
          const current = button.getAttribute('data-current-active') === 'true';
          if (!id) return;

          try {
            const { error } = await supabase
              .from('hero_slides')
              .update({ is_active: !current })
              .eq('id', id);

            if (error) throw error;
            showToast(`Slide status updated to ${!current ? 'Active' : 'Inactive'}.`);
            await loadSlides();
          } catch (err: any) {
            showToast('Failed to update status: ' + err.message, true);
          }
        });
      });
    }

    function openModal(slide?: DbHeroSlide) {
      if (!modal) return;
      if (modalError) modalError.classList.add('hidden');

      if (slide) {
        if (modalTitle) modalTitle.textContent = 'Edit Hero Slide';
        slideIdInput.value = slide.id;
        slideHeadingInput.value = slide.heading || '';
        slideDescInput.value = slide.description || '';
        slidePrimaryText.value = slide.primary_cta_text || '';
        slidePrimaryLink.value = slide.primary_cta_link || '';
        slideSecondaryText.value = slide.secondary_cta_text || '';
        slideSecondaryLink.value = slide.secondary_cta_link || '';
        slideOrderInput.value = slide.display_order.toString();
        slideIsActive.checked = Boolean(slide.is_active);
        originalImageUrl = slide.image_url;
        updateImagePreview(slide.image_url);
      } else {
        if (modalTitle) modalTitle.textContent = 'Add Hero Slide';
        slideIdInput.value = '';
        slideHeadingInput.value = '';
        slideDescInput.value = '';
        slidePrimaryText.value = 'Shop Collection';
        slidePrimaryLink.value = '/shop';
        slideSecondaryText.value = 'Custom Orders';
        slideSecondaryLink.value = '/custom';
        slideOrderInput.value = (slides.length + 1).toString();
        slideIsActive.checked = true;
        originalImageUrl = null;
        updateImagePreview(null);
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      slideHeadingInput.focus();
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // Modal submit handler
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (modalError) modalError.classList.add('hidden');

      const id = slideIdInput.value;
      const heading = slideHeadingInput.value.trim();
      const description = slideDescInput.value.trim() || null;
      const primaryCtaText = slidePrimaryText.value.trim() || null;
      const primaryCtaLink = slidePrimaryLink.value.trim() || null;
      const secondaryCtaText = slideSecondaryText.value.trim() || null;
      const secondaryCtaLink = slideSecondaryLink.value.trim() || null;
      const displayOrder = parseInt(slideOrderInput.value) || 0;
      const isActive = slideIsActive.checked;

      if (!currentImageUrl) {
        if (modalError) {
          modalError.textContent = 'Please upload or select an image for this slide.';
          modalError.classList.remove('hidden');
        }
        return;
      }

      if (!heading) {
        if (modalError) {
          modalError.textContent = 'Heading is required.';
          modalError.classList.remove('hidden');
        }
        return;
      }

      saveBtn.disabled = true;
      saveText.textContent = 'Saving...';
      saveSpinner.classList.remove('hidden');

      try {
        if (id) {
          // Update
          const { error } = await supabase
            .from('hero_slides')
            .update({
              image_url: currentImageUrl,
              heading,
              description,
              primary_cta_text: primaryCtaText,
              primary_cta_link: primaryCtaLink,
              secondary_cta_text: secondaryCtaText,
              secondary_cta_link: secondaryCtaLink,
              display_order: displayOrder,
              is_active: isActive,
            })
            .eq('id', id);

          if (error) throw error;

          // If image was replaced, clean up old file from storage safely
          if (originalImageUrl && originalImageUrl !== currentImageUrl) {
            await cleanStorageFile(originalImageUrl);
          }

          showToast('Hero slide updated successfully.');
        } else {
          // Insert
          const { error } = await supabase
            .from('hero_slides')
            .insert({
              image_url: currentImageUrl,
              heading,
              description,
              primary_cta_text: primaryCtaText,
              primary_cta_link: primaryCtaLink,
              secondary_cta_text: secondaryCtaText,
              secondary_cta_link: secondaryCtaLink,
              display_order: displayOrder,
              is_active: isActive,
            });

          if (error) throw error;
          showToast('Hero slide created successfully.');
        }

        closeModal();
        await loadSlides();
      } catch (err: any) {
        if (modalError) {
          modalError.textContent = err?.message || 'Failed to save hero slide.';
          modalError.classList.remove('hidden');
        }
      } finally {
        saveBtn.disabled = false;
        saveText.textContent = 'Save Slide';
        saveSpinner.classList.add('hidden');
      }
    });

    function handleDeleteClick(slide: DbHeroSlide) {
      deleteTargetId = slide.id;
      deleteTargetSlide = slide;

      if (deleteModalMsg) {
        deleteModalMsg.textContent = `Are you sure you want to delete the slide "${slide.heading || 'Untitled'}"? This action cannot be undone.`;
      }
      if (deleteModal) {
        deleteModal.classList.remove('hidden');
        deleteModal.classList.add('flex');
      }
    }

    confirmDeleteBtn?.addEventListener('click', async () => {
      if (!deleteTargetId) return;

      try {
        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.textContent = 'Deleting...';

        const { error } = await supabase
          .from('hero_slides')
          .delete()
          .eq('id', deleteTargetId);

        if (error) throw error;

        // Clean up storage file if it was hosted in Supabase product-images
        if (deleteTargetSlide?.image_url) {
          await cleanStorageFile(deleteTargetSlide.image_url);
        }

        showToast('Hero slide deleted successfully.');
        if (deleteModal) {
          deleteModal.classList.add('hidden');
          deleteModal.classList.remove('flex');
        }
        await loadSlides();
      } catch (err: any) {
        showToast('Failed to delete slide: ' + (err?.message || 'Error'), true);
      } finally {
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = 'Delete Permanently';
        deleteTargetId = null;
        deleteTargetSlide = null;
      }
    });

    cancelDeleteBtn?.addEventListener('click', () => {
      if (deleteModal) {
        deleteModal.classList.add('hidden');
        deleteModal.classList.remove('flex');
      }
      deleteTargetId = null;
      deleteTargetSlide = null;
    });

    document.getElementById('add-slide-btn')?.addEventListener('click', () => openModal());
    document.getElementById('empty-add-btn')?.addEventListener('click', () => openModal());
    document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
    document.getElementById('cancel-modal-btn')?.addEventListener('click', closeModal);

    // Initial load when admin authentication is confirmed
    window.addEventListener('template:admin-ready', () => {
      loadSlides();
    });
  </script>
</AdminLayout>
