---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { siteConfig, getWhatsAppLink, hasWhatsApp, hasEmail } from '../config/site';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;

// Ensure 500 status code in SSR mode
Astro.response.status = 500;

const errorMessage = error instanceof Error ? error.message : null;
---

<Layout
  title={`500: Server Error — ${siteConfig.brand.name}`}
  description="Our server encountered an unexpected error. Please try again in a few moments."
>
  <main class="py-16 md:py-24 bg-surface min-h-[75vh] flex items-center">
    <div class="container-page max-w-2xl text-center">
      <!-- Warning Graphic -->
      <div class="relative w-36 h-36 mx-auto mb-8 flex items-center justify-center">
        <div class="absolute inset-0 bg-amber-500/10 rounded-full blur-2xl"></div>

        <div class="relative z-10 w-28 h-28 rounded-3xl bg-surface-bright border border-border shadow-xs flex flex-col items-center justify-center p-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 mb-1">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <span class="text-xs font-mono font-bold tracking-widest text-stone-500 uppercase">500</span>
        </div>
      </div>

      <!-- Badge -->
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 mb-4 border border-amber-200">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Server Error • Code 500
      </span>

      <!-- Title & Copy -->
      <h1 class="text-3xl md:text-4xl font-extrabold text-text-primary tracking-tight mb-4">
        Internal Server Error
      </h1>
      <p class="text-base text-text-secondary max-w-lg mx-auto mb-8 leading-relaxed">
        Something went wrong while processing your request. Please try reloading the page, or return to the homepage.
      </p>

      {errorMessage && (
        <div class="mb-8 p-4 rounded-xl bg-surface-muted border border-border text-left max-w-md mx-auto">
          <p class="text-[11px] font-mono uppercase tracking-wider text-text-tertiary mb-1">Diagnostic Details:</p>
          <p class="text-xs font-mono text-red-600 break-words">{errorMessage}</p>
        </div>
      )}

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-10">
        <button
          onclick="window.location.reload()"
          class="inline-flex items-center justify-center font-medium transition-all duration-300 px-6 py-3 text-base rounded-xl gap-2.5 bg-brand-600 text-white hover:bg-brand-700 shadow-md cursor-pointer hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
            <path d="M16 21h5v-5"/>
          </svg>
          Reload Page
        </button>
        <Button href="/" variant="secondary">
          Return to Home
        </Button>
        {hasWhatsApp() ? (
          <Button href={getWhatsAppLink("Hello! I experienced a server error on the store.")} variant="outline">
            Report via WhatsApp
          </Button>
        ) : (
          <Button href="/contact" variant="outline">
            Contact Support
          </Button>
        )}
      </div>

      <p class="text-xs text-text-tertiary">
        {hasEmail() ? (
          <>If the issue persists, our support team is available at <a href={`mailto:${siteConfig.contact.email}`} class="underline hover:text-brand-600">{siteConfig.contact.email}</a>.</>
        ) : (
          <>If the issue persists, please reach out to us via our <a href="/contact" class="underline hover:text-brand-600">contact page</a>.</>
        )}
      </p>
    </div>
  </main>
</Layout>
