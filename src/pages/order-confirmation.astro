---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { siteConfig, getWhatsAppLink } from '../config/site';
---

<Layout title={`Order Confirmation — ${siteConfig.brand.name}`}>
  <section class="py-16 md:py-24 bg-surface-subtle min-h-[75vh]">
    <div class="container-page max-w-2xl text-center">

      <!-- Loading State -->
      <div id="state-loading" class="py-12">
        <div class="inline-flex items-center gap-3 px-5 py-3 rounded-full bg-surface-bright border border-border shadow-xs text-stone-600 text-sm">
          <svg class="animate-spin w-5 h-5 text-stone-900" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span class="font-medium">Retrieving verified order details...</span>
        </div>
      </div>

      <!-- Confirmed & Paid State -->
      <div id="state-confirmed" class="hidden">
        <!-- Success Icon -->
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200/80 flex items-center justify-center shadow-xs animate-scale-in">
          <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h1 class="text-3xl md:text-4xl font-extrabold text-stone-900 tracking-tight mb-3">Order Confirmed</h1>
        <p id="confirmation-subtitle" class="text-base text-stone-600 mb-8 max-w-lg mx-auto leading-relaxed">
          Thank you for your order. We have securely received your details and are preparing it for fulfillment.
        </p>

        <!-- Order Summary Receipt Card -->
        <div class="bg-surface-bright rounded-2xl p-6 sm:p-8 mb-8 text-left border border-border shadow-subtle">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-border/80">
            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-stone-500 font-semibold block mb-0.5">Order Reference</span>
              <span id="order-id" class="text-2xl font-bold font-mono text-stone-900">--</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <!-- Payment Status Badge -->
              <div id="badge-payment" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="text-[10px] uppercase font-bold text-emerald-600/75">Payment:</span>
                <span id="badge-payment-text">PAID</span>
              </div>
              <!-- Fulfillment Status Badge -->
              <div id="badge-fulfillment" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                <span class="text-[10px] uppercase font-bold text-amber-600/75">Fulfillment:</span>
                <span id="badge-fulfillment-text">PENDING</span>
              </div>
            </div>
          </div>

          <!-- Shipment Tracking Banner (Shown ONLY when status is shipped/delivered and tracking number exists) -->
          <div id="tracking-section" class="hidden my-4 p-4 rounded-xl bg-surface border border-stone-200 shadow-2xs">
            <div class="flex items-center justify-between flex-wrap gap-3">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-stone-900 text-white flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                  </svg>
                </div>
                <div>
                  <div class="text-[10px] font-mono uppercase tracking-wider text-stone-500 font-semibold">Shipment Tracking</div>
                  <div class="text-sm font-bold text-stone-900">
                    Tracking / AWB: <span id="tracking-number-val" class="font-mono text-brand-700 tracking-wide select-all">--</span>
                  </div>
                </div>
              </div>
              <button
                id="copy-awb-btn"
                type="button"
                class="text-xs font-medium px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-800 rounded-lg transition-colors border border-stone-200 cursor-pointer inline-flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span id="copy-awb-text">Copy AWB</span>
              </button>
            </div>
          </div>

          <!-- Customer details -->
          <div id="customer-info" class="py-3.5 text-xs text-stone-600 border-b border-border/80 flex flex-wrap justify-between gap-2">
            <span>Delivering to: <strong id="customer-name" class="font-medium text-stone-900">--</strong></span>
            <span id="customer-destination" class="text-stone-500">--</span>
          </div>

          <!-- Items list -->
          <div id="order-summary" class="space-y-3.5 py-5 border-b border-border/80">
            <!-- Items rendered via script -->
          </div>

          <!-- Cost breakdown -->
          <div class="py-4 border-b border-border/80 space-y-2 text-xs sm:text-sm text-stone-600">
            <div class="flex justify-between items-center">
              <span>Subtotal</span>
              <span id="order-subtotal" class="font-medium text-stone-900 font-mono tabular-nums">₹0</span>
            </div>
            <div class="flex justify-between items-center">
              <div class="flex items-center gap-1.5">
                <span>Shipping</span>
                <span class="text-[10px] font-mono text-stone-500 bg-stone-100 px-1.5 py-0.5 rounded">Flat rate</span>
              </div>
              <span id="order-shipping" class="font-medium text-stone-900 font-mono tabular-nums">₹110</span>
            </div>
          </div>

          <!-- Total breakdown -->
          <div class="pt-4 flex items-center justify-between text-base">
            <span id="order-total-label" class="font-medium text-stone-600">Total Paid</span>
            <span id="order-total" class="text-2xl font-bold font-mono text-stone-900">₹0</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
          <a
            id="track-later-btn"
            href="/track-order"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 bg-stone-900 hover:bg-stone-800 text-white font-medium rounded-lg transition-all shadow-xs text-sm cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <span>Track this order later</span>
          </a>
          <a
            id="whatsapp-btn"
            href={getWhatsAppLink('Hi! I just placed an order.')}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg transition-all shadow-xs hover:shadow-subtle cursor-pointer text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>WhatsApp Support</span>
          </a>
          <Button href="/shop" variant="outline" size="md">Continue Shopping</Button>
        </div>
      </div>

      <!-- Pending / Awaiting Webhook State -->
      <div id="state-pending" class="hidden">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-amber-50 text-amber-600 border border-amber-200/80 flex items-center justify-center shadow-xs">
          <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>

        <h1 class="text-3xl font-bold text-stone-900 mb-3 tracking-tight">Payment Verification In Progress</h1>
        <p class="text-base text-stone-600 mb-6 max-w-lg mx-auto leading-relaxed">
          We are awaiting final confirmation from the payment gateway. If your account was debited, your order will automatically be confirmed within 1-2 minutes.
        </p>

        <div class="inline-flex flex-col sm:flex-row gap-3 justify-center mb-8">
          <button
            type="button"
            id="refresh-status-btn"
            class="px-6 py-3 bg-stone-900 hover:bg-stone-800 text-white text-sm font-medium rounded-lg transition-all cursor-pointer shadow-xs"
          >
            Check Status Again
          </button>
          <a
            href={getWhatsAppLink('Hi! I placed an order but payment is still pending confirmation.')}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-surface-bright hover:bg-surface border border-border text-stone-800 text-sm font-medium rounded-lg transition-all"
          >
            Contact WhatsApp Support
          </a>
        </div>
      </div>

      <!-- Failed State -->
      <div id="state-failed" class="hidden">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-red-50 text-red-600 border border-red-200/80 flex items-center justify-center shadow-xs">
          <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>

        <h1 id="failed-title" class="text-3xl font-bold text-stone-900 mb-3 tracking-tight">Payment Incomplete</h1>
        <p id="failed-desc" class="text-base text-stone-600 mb-6 max-w-lg mx-auto leading-relaxed">
          The payment transaction was not completed or failed bank authorization. No charges were captured.
        </p>

        <div class="flex gap-4 justify-center">
          <Button href="/checkout" size="lg">Return to Checkout</Button>
          <Button href="/shop" variant="outline" size="lg">Back to Shop</Button>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { getWhatsAppLink } from '../config/site';

  function escapeHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>'"]/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;',
    }[char] || char));
  }

  const stateLoading = document.getElementById('state-loading');
  const stateConfirmed = document.getElementById('state-confirmed');
  const statePending = document.getElementById('state-pending');
  const stateFailed = document.getElementById('state-failed');

  const orderIdEl = document.getElementById('order-id');
  const orderTotalEl = document.getElementById('order-total');
  const orderSummaryEl = document.getElementById('order-summary');
  const customerNameEl = document.getElementById('customer-name');
  const customerDestinationEl = document.getElementById('customer-destination');
  const whatsappBtn = document.getElementById('whatsapp-btn') as HTMLAnchorElement | null;
  const refreshStatusBtn = document.getElementById('refresh-status-btn');

  const failedTitle = document.getElementById('failed-title');
  const failedDesc = document.getElementById('failed-desc');

  function showView(view: 'loading' | 'confirmed' | 'pending' | 'failed') {
    stateLoading?.classList.toggle('hidden', view !== 'loading');
    stateConfirmed?.classList.toggle('hidden', view !== 'confirmed');
    statePending?.classList.toggle('hidden', view !== 'pending');
    stateFailed?.classList.toggle('hidden', view !== 'failed');
  }

  async function loadOrder() {
    showView('loading');

    const params = new URLSearchParams(window.location.search);
    let orderUuid = params.get('order_id');
    let phone = params.get('phone');

    // If query params are missing from URL, attempt to recover identifiers from local snapshot
    if (!orderUuid || !phone) {
      const lastOrderStr = localStorage.getItem('lastOrder');
      if (lastOrderStr) {
        try {
          const localOrder = JSON.parse(lastOrderStr);
          if (localOrder?.orderUuid && localOrder?.phone) {
            orderUuid = localOrder.orderUuid;
            phone = localOrder.phone;
          }
        } catch (e) {
          console.warn('Local order parse notice:', e);
        }
      }
    }

    // If no order identifier exists at all, redirect to catalog
    if (!orderUuid || !phone) {
      window.location.href = '/shop';
      return;
    }

    // Authoritative Server Verification: Fetch order status from database via secure RPC
    try {
      const { data: order, error } = await supabase.rpc('get_guest_order', {
        p_order_id: orderUuid,
        p_phone: phone,
      });

      if (error || !order || !order.id) {
        console.warn('Authoritative order lookup failed:', error?.message);
        if (failedTitle) failedTitle.textContent = 'Order Not Found';
        if (failedDesc) failedDesc.textContent = 'We could not locate this order with the provided credentials. Please check your link or contact support.';
        showView('failed');
        return;
      }

      // Check for cancelled / failed status
      if (order.status === 'cancelled' || order.payment_status === 'failed') {
        if (failedTitle) failedTitle.textContent = 'Payment Incomplete';
        if (failedDesc) failedDesc.textContent = 'This order checkout was cancelled or payment authorization was not completed. No charges were captured.';
        showView('failed');
        return;
      }

      // Cash on Delivery orders
      if (order.payment_method === 'cod') {
        renderConfirmedOrder(order);
        showView('confirmed');
        return;
      }

      // Online Razorpay orders: ONLY show confirmed if database confirms payment_status === 'paid'
      if (order.payment_status === 'paid') {
        renderConfirmedOrder(order);
        showView('confirmed');
        return;
      }

      // If Razorpay payment is still pending confirmation (e.g. UPI QR awaiting webhook)
      if (order.payment_status === 'pending') {
        showView('pending');
        return;
      }

      // Fallback: unconfirmed/unhandled state
      showView('failed');
    } catch (err: any) {
      console.error('Order verification network error:', err);
      if (failedTitle) failedTitle.textContent = 'Unable to Verify Order';
      if (failedDesc) failedDesc.textContent = 'A connection error occurred while checking order status. Please click "Check Status Again" or contact WhatsApp support.';
      showView('failed');
    }
  }

  function renderConfirmedOrder(order: any) {
    if (orderIdEl) orderIdEl.textContent = `#${order.order_number}`;
    if (orderTotalEl) orderTotalEl.textContent = `₹${Number(order.total).toLocaleString('en-IN')}`;
    if (customerNameEl) customerNameEl.textContent = order.customer_name || 'Customer';
    if (customerDestinationEl) customerDestinationEl.textContent = `${order.shipping_city || ''}, ${order.shipping_state || ''}`;

    const orderSubtotalEl = document.getElementById('order-subtotal');
    const orderShippingEl = document.getElementById('order-shipping');
    if (orderSubtotalEl) orderSubtotalEl.textContent = `₹${Number(order.subtotal || 0).toLocaleString('en-IN')}`;
    if (orderShippingEl) orderShippingEl.textContent = `₹${Number(order.shipping_fee || 110).toLocaleString('en-IN')}`;

    // Separate Payment Status and Fulfillment Status Display
    const badgePayment = document.getElementById('badge-payment');
    const badgePaymentText = document.getElementById('badge-payment-text');
    const badgeFulfillment = document.getElementById('badge-fulfillment');
    const badgeFulfillmentText = document.getElementById('badge-fulfillment-text');

    const orderTotalLabel = document.getElementById('order-total-label');
    const confirmationSubtitle = document.getElementById('confirmation-subtitle');

    // 1. Payment Status Badge
    if (order.payment_method === 'cod') {
      if (badgePayment) {
        badgePayment.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-stone-100 text-stone-800 border border-stone-300';
      }
      if (badgePaymentText) {
        badgePaymentText.textContent = 'PENDING (COD)';
      }
      if (orderTotalLabel) {
        orderTotalLabel.textContent = 'Amount to Pay on Delivery';
      }
      if (confirmationSubtitle) {
        confirmationSubtitle.textContent = 'Thank you for your order. It has been placed successfully and will be prepared for dispatch. Please keep cash or UPI ready on delivery.';
      }
    } else {
      if (badgePayment) {
        badgePayment.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
      }
      if (badgePaymentText) {
        badgePaymentText.textContent = 'PAID';
      }
      if (orderTotalLabel) {
        orderTotalLabel.textContent = 'Total Paid';
      }
      if (confirmationSubtitle) {
        confirmationSubtitle.textContent = 'Thank you for your order. Your payment has been securely verified, and we have received your order for fulfillment.';
      }
    }

    // 2. Fulfillment Status Badge
    const fulfillmentStatus = (order.status || 'pending').toLowerCase();
    if (badgeFulfillmentText) {
      badgeFulfillmentText.textContent = fulfillmentStatus.toUpperCase();
    }
    if (badgeFulfillment) {
      if (fulfillmentStatus === 'pending') {
        badgeFulfillment.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200';
      } else if (fulfillmentStatus === 'confirmed' || fulfillmentStatus === 'processing') {
        badgeFulfillment.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200';
      } else if (fulfillmentStatus === 'shipped' || fulfillmentStatus === 'delivered') {
        badgeFulfillment.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
      } else if (fulfillmentStatus === 'cancelled') {
        badgeFulfillment.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200';
      } else {
        badgeFulfillment.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-stone-100 text-stone-700 border border-stone-200';
      }
    }

    // 3. Manual Shipment Tracking Information (AWB)
    // Only display when status is shipped/delivered and tracking number is available
    const trackingSection = document.getElementById('tracking-section');
    const trackingNumberVal = document.getElementById('tracking-number-val');
    const hasTracking = order.tracking_number && typeof order.tracking_number === 'string' && order.tracking_number.trim() !== '';

    if ((fulfillmentStatus === 'shipped' || fulfillmentStatus === 'delivered') && hasTracking) {
      trackingSection?.classList.remove('hidden');
      if (trackingNumberVal) trackingNumberVal.textContent = order.tracking_number.trim();
    } else {
      trackingSection?.classList.add('hidden');
    }

    // Copy AWB Number Handler
    const copyAwbBtn = document.getElementById('copy-awb-btn');
    const copyAwbText = document.getElementById('copy-awb-text');
    copyAwbBtn?.addEventListener('click', () => {
      const awb = trackingNumberVal?.textContent?.trim();
      if (awb && awb !== '--') {
        navigator.clipboard.writeText(awb).then(() => {
          if (copyAwbText) copyAwbText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyAwbText) copyAwbText.textContent = 'Copy AWB';
          }, 2000);
        }).catch(() => {});
      }
    });

    if (orderSummaryEl && Array.isArray(order.items)) {
      orderSummaryEl.innerHTML = order.items.map((item: any) => `
        <div class="flex items-center justify-between text-sm py-2">
          <div class="flex items-center gap-3">
            ${item.product_image ? `<img src="${escapeHtml(item.product_image)}" alt="${escapeHtml(item.product_name)}" class="w-12 h-12 rounded-lg object-contain bg-stone-100/60 p-1 border border-border" />` : ''}
            <div>
              <span class="font-medium text-stone-900 block">${escapeHtml(item.product_name)}</span>
              <span class="text-xs text-stone-500">Qty: ${Number(item.quantity) || 1}${item.selected_color ? ` · Color: ${escapeHtml(item.selected_color)}` : ''}</span>
            </div>
          </div>
          <span class="font-semibold font-mono text-stone-900">₹${Number(item.total_price).toLocaleString('en-IN')}</span>
        </div>
      `).join('');
    }

    if (whatsappBtn) {
      const trackingMsg = (fulfillmentStatus === 'shipped' || fulfillmentStatus === 'delivered') && hasTracking
        ? `Hi! Checking in on dispatched order #${order.order_number} (AWB: ${order.tracking_number.trim()}).`
        : `Hi! I just placed order #${order.order_number}. Could you please confirm status?`;
      whatsappBtn.href = getWhatsAppLink(trackingMsg);
    }

    const trackLaterBtn = document.getElementById('track-later-btn') as HTMLAnchorElement | null;
    if (trackLaterBtn && order.order_number && order.customer_phone) {
      trackLaterBtn.href = `/track-order?order=${encodeURIComponent(order.order_number)}&phone=${encodeURIComponent(order.customer_phone)}`;
    }
  }

  refreshStatusBtn?.addEventListener('click', () => {
    loadOrder();
  });

  loadOrder();
</script>
