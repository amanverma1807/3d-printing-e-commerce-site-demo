---
import Layout from '../layouts/Layout.astro';
import PolicyNav from '../components/PolicyNav.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../config/site';

const lastUpdated = "September 2024";
---

<Layout
  title={`Privacy Policy — ${siteConfig.brand.name}`}
  description="How we protect your personal information and safeguard your privacy and orders."
>
  <main class="py-12 md:py-20 bg-surface">
    <div class="container-page max-w-4xl">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs text-text-tertiary">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li>/</li>
          <li class="text-text-primary font-medium">Privacy Policy</li>
        </ol>
      </nav>

      <!-- Header -->
      <div class="text-center mb-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-100 text-brand-700 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Privacy & Data Protection
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Privacy Policy
        </h1>
        <p class="text-base md:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">
          Your privacy and data security matter. We treat your personal data and order details with utmost discretion and security.
        </p>
        <p class="text-xs text-text-tertiary mt-3">
          Last revised: {lastUpdated} • Compliant with Indian IT Act (SPDI Rules) & Global Privacy Standards
        </p>
      </div>

      <!-- Navigation Tabs -->
      <PolicyNav active="privacy" />

      <!-- Special Highlight: Confidentiality Guarantee -->
      <div class="mb-10 p-6 rounded-2xl bg-brand-900 text-white shadow-md relative overflow-hidden">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-brand-700 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold mb-1">Our Confidentiality Commitment</h2>
            <p class="text-sm text-brand-100 leading-relaxed">
              When you share custom specifications, design assets, or personalization requests with us, you retain <strong>100% intellectual property ownership</strong>. We never sell, share, or misuse your proprietary designs or custom information.
            </p>
          </div>
        </div>
      </div>

      <!-- Main Policy Sections -->
      <div class="space-y-8">
        <!-- Section 1: Information Collected -->
        <section class="bg-surface-bright rounded-2xl p-6 md:p-8 border border-border shadow-xs">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm">1</span>
            <h2 class="text-xl md:text-2xl font-bold text-text-primary">Information We Collect</h2>
          </div>
          <div class="space-y-4 text-sm md:text-base text-text-secondary leading-relaxed">
            <p>
              We collect information that you provide directly to us when browsing our store, submitting inquiries, or placing an order:
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Contact Information:</strong> Full name, email address, delivery address, city, state, postal PIN code, and mobile phone number for logistics coordination.</li>
              <li><strong>Order Data:</strong> Selected products, quantities, custom specifications, material choices, color selections, and transaction references.</li>
              <li><strong>Design & Custom Assets:</strong> Files, sketches, or reference documents shared for custom orders and consultations.</li>
              <li><strong>Technical Metadata:</strong> IP address, browser type, device information, and interaction data collected automatically to diagnose site performance and prevent fraud.</li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Payment Security -->
        <section class="bg-surface-bright rounded-2xl p-6 md:p-8 border border-border shadow-xs">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm">2</span>
            <h2 class="text-xl md:text-2xl font-bold text-text-primary">Payment Security & Tokenization</h2>
          </div>
          <p class="text-text-secondary text-sm md:text-base leading-relaxed mb-4">
            We prioritize the highest security for your monetary transactions:
          </p>
          <div class="p-4 rounded-xl bg-surface-muted border border-border text-sm text-text-secondary space-y-2">
            <p>
              • We <strong>NEVER store, log, or have access to</strong> your raw credit card numbers, debit card CVVs, net banking passwords, or UPI PINs.
            </p>
            <p>
              • All transactions are encrypted via 256-bit TLS and processed directly by RBI-authorized, PCI-DSS Level 1 compliant payment gateways.
            </p>
          </div>
        </section>

        <!-- Section 3: How We Use Your Data -->
        <section class="bg-surface-bright rounded-2xl p-6 md:p-8 border border-border shadow-xs">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm">3</span>
            <h2 class="text-xl md:text-2xl font-bold text-text-primary">How We Use Your Information</h2>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-surface-muted border border-border">
              <h3 class="font-semibold text-text-primary text-sm mb-1.5">Order Fulfillment & Processing</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                To process orders, assemble items, perform QA checks, and package your delivery.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface-muted border border-border">
              <h3 class="font-semibold text-text-primary text-sm mb-1.5">Delivery Updates & Tracking</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                To dispatch tracking links and automated delivery milestones via WhatsApp, SMS, and email.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface-muted border border-border">
              <h3 class="font-semibold text-text-primary text-sm mb-1.5">Customer Support</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                To resolve technical inquiries, customize dimensions, handle returns, or replace damaged items.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface-muted border border-border">
              <h3 class="font-semibold text-text-primary text-sm mb-1.5">Platform Security</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                To detect and prevent fraudulent transactions, unauthorized access, and malicious abuse.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 4: Data Retention & Purging -->
        <section class="bg-surface-bright rounded-2xl p-6 md:p-8 border border-border shadow-xs">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm">4</span>
            <h2 class="text-xl md:text-2xl font-bold text-text-primary">Custom Assets Retention & Purging</h2>
          </div>
          <p class="text-text-secondary text-sm md:text-base leading-relaxed mb-4">
            Unless you request otherwise, we retain submitted custom files or references for a period of <strong>90 days</strong> solely for the purpose of re-orders, revisions, or warranty inquiries.
          </p>
          <p class="text-text-secondary text-sm md:text-base leading-relaxed">
            You may email us at any time at <a href={`mailto:${siteConfig.contact.email}`} class="text-brand-600 underline font-medium">{siteConfig.contact.email}</a> to request immediate and permanent deletion of your custom files from our storage.
          </p>
        </section>

        <!-- Section 5: Third-Party Service Providers -->
        <section class="bg-surface-bright rounded-2xl p-6 md:p-8 border border-border shadow-xs">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm">5</span>
            <h2 class="text-xl md:text-2xl font-bold text-text-primary">Authorized Third-Party Partners</h2>
          </div>
          <p class="text-text-secondary text-sm md:text-base leading-relaxed mb-4">
            We do not sell your personal data. We disclose necessary information exclusively to trusted third parties who assist in operating our store:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-sm text-text-secondary">
            <li><strong>Logistics Partners:</strong> Courier aggregators (e.g. Shiprocket, Delhivery, Bluedart) receive your shipping address and contact number solely to complete doorstep delivery.</li>
            <li><strong>Database & Cloud Hosting:</strong> Secure cloud infrastructure maintaining encrypted database storage with strict access controls.</li>
            <li><strong>Regulatory Compliance:</strong> We may disclose information if mandated by applicable court summons, government authority, or law enforcement under applicable jurisdiction.</li>
          </ul>
        </section>

        <!-- Section 6: Cookies -->
        <section class="bg-surface-bright rounded-2xl p-6 md:p-8 border border-border shadow-xs">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm">6</span>
            <h2 class="text-xl md:text-2xl font-bold text-text-primary">Cookies & Local Storage</h2>
          </div>
          <p class="text-text-secondary text-sm md:text-base leading-relaxed mb-3">
            Our site uses lightweight browser cookies and local storage tokens strictly to maintain your active shopping cart items, remember your UI preferences, and provide smooth session persistence. You can disable cookies in your browser settings at any time, though this may require you to re-add products to your cart.
          </p>
        </section>
      </div>

      <!-- Privacy Officer Contact -->
      <div class="mt-12 p-8 rounded-3xl bg-surface-bright border border-border text-center">
        <h2 class="text-xl md:text-2xl font-bold text-text-primary mb-2">Have a question regarding your data?</h2>
        <p class="text-text-secondary text-sm mb-6 max-w-lg mx-auto">
          Contact our Privacy & Data Grievance Officer directly. We answer all data requests within 48 hours.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <Button href={`mailto:${siteConfig.contact.email}`} variant="primary">
            Email Privacy Desk
          </Button>
          <Button href="/contact" variant="outline">
            General Contact Page
          </Button>
        </div>
      </div>
    </div>
  </main>
</Layout>
