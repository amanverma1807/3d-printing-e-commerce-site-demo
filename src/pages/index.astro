---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ProductCard from '../components/ProductCard.astro';
import { siteConfig, getWhatsAppLink, hasWhatsApp } from '../config/site';
import { getFeaturedProducts, getStoreCategories, getHeroSlides } from '../lib/catalog';

const [featuredProducts, dbCategories, heroSlides] = await Promise.all([
  getFeaturedProducts(),
  getStoreCategories(),
  getHeroSlides(),
]);

const categories = dbCategories.length > 0 ? dbCategories : siteConfig.categories;
const slides = heroSlides.length > 0 ? heroSlides : [
  {
    id: 'default-1',
    image_url: '/assets/p1.png',
    heading: 'Quality Products. Designed to Stand Out.',
    description: 'From precision craftsmanship to curated essentials, every piece is designed with premium materials and meticulous attention to detail.',
    primary_cta_text: 'Shop Collection',
    primary_cta_link: '/shop',
    secondary_cta_text: 'Explore Catalog',
    secondary_cta_link: '/shop',
    display_order: 1,
    is_active: true,
    created_at: '',
    updated_at: '',
  }
];
---

<Layout>
  <!-- Hero -->
  <section class="relative min-h-[100vh] flex items-center bg-surface-night text-text-inverse overflow-hidden">
    <!-- Hero Carousel - integrated as background layer with synchronized content -->
    <div class="hero-carousel-container">
      <!-- Carousel track -->
      <div class="carousel-track">
        {slides.map((slide, i) => (
          <div class={`carousel-slide ${i === 0 ? 'active' : ''}`} data-index={i}>
            <!-- Slide Image -->
            <img
              src={slide.image_url}
              alt={slide.heading || 'Store Showcase'}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="carousel-image"
            />
            
            <!-- Overlay for text readability (directional vignette: protects left headline while showcasing artwork) -->
            <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/50 to-black/20 z-[1]"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/30 z-[1] pointer-events-none"></div>
            
            <!-- Slide Synchronized Content -->
            <div class="carousel-content-wrapper container-page py-20 relative z-10 w-full flex items-center">
              <div class="max-w-3xl slide-text-box">
                <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl font-medium tracking-tighter text-text-inverse mb-6 text-balance leading-[1.08] animate-fade-up">
                  {slide.heading}
                </h1>
                {slide.description && (
                  <p class="text-base sm:text-lg md:text-xl text-text-tertiary mb-10 text-pretty max-w-2xl animate-fade-up delay-100 font-light">
                    {slide.description}
                  </p>
                )}
                <div class="flex flex-wrap gap-4 animate-fade-up delay-200">
                  {slide.primary_cta_text && (
                    <Button href={slide.primary_cta_link || '/shop'} size="lg">
                      {slide.primary_cta_text}
                    </Button>
                  )}
                  {slide.secondary_cta_text && (
                    <Button href={slide.secondary_cta_link || '/custom'} variant="outline" size="lg">
                      {slide.secondary_cta_text}
                    </Button>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation buttons (only if multiple slides) -->
      {slides.length > 1 && (
        <>
          <button type="button" class="carousel-prev" aria-label="Previous slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          
          <button type="button" class="carousel-next" aria-label="Next slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>

          <!-- Pagination pills/dots -->
          <div class="carousel-dots">
            {slides.map((_, i) => (
              <button
                type="button"
                class={`carousel-dot ${i === 0 ? 'active' : ''}`}
                data-index={i}
                aria-label={`Go to slide ${i + 1}`}
              ></button>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- Carousel styles -->
    <style>
      .hero-carousel-container {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        z-index: 0;
        display: flex;
        align-items: center;
      }
      
      .carousel-track {
        position: absolute;
        inset: 0;
      }
      
      .carousel-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.6s ease-in-out, transform 0.6s ease-in-out, visibility 0.6s ease-in-out;
        display: flex;
        align-items: center;
        pointer-events: none;
      }
      
      .carousel-slide.active {
        opacity: 1;
        visibility: visible;
        transform: scale(1);
        pointer-events: auto;
        z-index: 2;
      }
      
      .carousel-slide:not(.active) {
        transform: scale(0.98);
        pointer-events: none;
      }
      
      .carousel-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        max-width: none;
        max-height: none;
        z-index: 0;
      }

      .carousel-content-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
      }
      
      .carousel-prev,
      .carousel-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 9999px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        color: #ffffff;
        z-index: 20;
      }
      
      .carousel-prev:hover,
      .carousel-next:hover {
        background: rgba(0, 0, 0, 0.7);
        border-color: rgba(255, 255, 255, 0.4);
        transform: translateY(-50%) scale(1.05);
      }
      
      .carousel-prev {
        left: var(--container-padding);
      }
      
      .carousel-next {
        right: var(--container-padding);
      }
      
      .carousel-dots {
        position: absolute;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        z-index: 20;
      }
      
      .carousel-dot {
        height: 6px;
        width: 10px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.4);
        border: none;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        padding: 0;
      }
      
      .carousel-dot.active {
        background: #ffffff;
        width: 28px;
      }
      
      .carousel-dot:hover:not(.active) {
        background: rgba(255, 255, 255, 0.7);
      }
      
      @media (max-width: 768px) {
        .carousel-prev,
        .carousel-next {
          width: 38px;
          height: 38px;
        }
        
        .carousel-prev {
          left: 0.75rem;
        }
        
        .carousel-next {
          right: 0.75rem;
        }
        
        .carousel-dots {
          bottom: 1.5rem;
        }
      }
    </style>
  </section>

  <!-- Category Discovery (Asymmetrical Bento Grid) -->
  <section class="py-20 sm:py-28 lg:py-32 bg-surface">
    <div class="container-page">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-4">
        <div>
          <p class="text-xs uppercase tracking-widest text-stone-500 font-mono mb-2">Curated Catalog</p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-stone-900">Explore by Category</h2>
        </div>
        <a href="/shop" class="text-sm font-medium text-stone-600 hover:text-stone-950 inline-flex items-center gap-1.5 transition-colors group">
          <span>View entire collection</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Bento Grid Architecture -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 lg:gap-6">
        {categories.slice(0, 6).map((cat, index) => {
          // Asymmetric layout assignment for up to 6 items
          let colClass = "lg:col-span-4 min-h-[260px] sm:min-h-[300px]";
          if (index === 0) {
            colClass = "sm:col-span-2 lg:col-span-7 lg:row-span-2 min-h-[360px] sm:min-h-[440px] lg:min-h-[540px]";
          } else if (index === 1) {
            colClass = "sm:col-span-1 lg:col-span-5 min-h-[260px] sm:min-h-[258px]";
          } else if (index === 2) {
            colClass = "sm:col-span-1 lg:col-span-5 min-h-[260px] sm:min-h-[258px]";
          } else {
            colClass = "sm:col-span-1 lg:col-span-4 min-h-[260px] sm:min-h-[280px]";
          }

          return (
            <a
              href={`/shop?category=${cat.slug}`}
              class={`group relative ${colClass} rounded-xl overflow-hidden bg-stone-900 border border-border/80 hover:border-stone-400 transition-all duration-300 shadow-subtle hover:shadow-soft flex flex-col justify-between p-6`}
            >
              {cat.image_url && (
                <img
                  src={cat.image_url}
                  alt={cat.name}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
                  loading="lazy"
                />
              )}
              <!-- Legibility gradient overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/10 transition-opacity duration-300 group-hover:from-black/90" />
              
              <!-- Top action pill -->
              <div class="relative z-10 flex justify-end">
                <span class="w-8 h-8 rounded-full bg-white/15 backdrop-blur-md text-white flex items-center justify-center group-hover:bg-white group-hover:text-stone-900 transition-all duration-300 shadow-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7M7 7h10v10"/>
                  </svg>
                </span>
              </div>

              <!-- Bottom content -->
              <div class="relative z-10 mt-auto">
                <span class="text-[11px] font-mono uppercase tracking-widest text-stone-300/90 block mb-1">
                  Collection 0{index + 1}
                </span>
                <h3 class="text-xl sm:text-2xl font-semibold text-white tracking-tight group-hover:translate-x-1 transition-transform duration-300">
                  {cat.name}
                </h3>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Products Showcase -->
  <section class="py-20 sm:py-28 lg:py-32 bg-surface-subtle border-t border-border">
    <div class="container-page">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-4">
        <div>
          <p class="text-xs uppercase tracking-widest text-stone-500 font-mono mb-2">Selected Works</p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-stone-900">Featured Products</h2>
        </div>
        <Button href="/shop" variant="outline" class="hidden md:inline-flex">View All Products →</Button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <div class="mt-10 text-center md:hidden">
        <Button href="/shop" variant="outline" class="w-full">View All Products</Button>
      </div>
    </div>
  </section>

  <!-- Craft & Process Section -->
  <section class="py-20 sm:py-28 lg:py-32 bg-surface border-t border-border">
    <div class="container-page">
      <div class="max-w-3xl mb-16 sm:mb-20">
        <p class="text-xs uppercase tracking-widest text-stone-500 font-mono mb-2">Our Philosophy</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-stone-900 mb-6">
          Quality in Every Detail.
        </h2>
        <p class="text-base sm:text-lg text-stone-600 font-light leading-relaxed">
          Great products come from thoughtful design and meticulous execution. We curate durable, expressive pieces designed for modern living.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Step 1 -->
        <div class="p-6 sm:p-8 rounded-xl bg-surface-bright border border-border shadow-subtle flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-stone-100 border border-stone-200 text-stone-800 flex items-center justify-center font-mono font-bold text-sm mb-6">
              01
            </div>
            <h3 class="text-lg font-semibold text-stone-900 mb-3 tracking-tight">Thoughtful Design</h3>
            <p class="text-sm text-stone-600 leading-relaxed font-light">
              Every piece begins with intentional aesthetics, balancing practical utility with timeless minimalist style.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="p-6 sm:p-8 rounded-xl bg-surface-bright border border-border shadow-subtle flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-stone-100 border border-stone-200 text-stone-800 flex items-center justify-center font-mono font-bold text-sm mb-6">
              02
            </div>
            <h3 class="text-lg font-semibold text-stone-900 mb-3 tracking-tight">Premium Materials</h3>
            <p class="text-sm text-stone-600 leading-relaxed font-light">
              We select high-grade, durable materials chosen for their resilience, tactile finish, and lasting quality.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="p-6 sm:p-8 rounded-xl bg-surface-bright border border-border shadow-subtle flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-stone-100 border border-stone-200 text-stone-800 flex items-center justify-center font-mono font-bold text-sm mb-6">
              03
            </div>
            <h3 class="text-lg font-semibold text-stone-900 mb-3 tracking-tight">Precision Engineering</h3>
            <p class="text-sm text-stone-600 leading-relaxed font-light">
              Our production processes ensure high consistency, robust build quality, and seamless everyday performance.
            </p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="p-6 sm:p-8 rounded-xl bg-surface-bright border border-border shadow-subtle flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-stone-100 border border-stone-200 text-stone-800 flex items-center justify-center font-mono font-bold text-sm mb-6">
              04
            </div>
            <h3 class="text-lg font-semibold text-stone-900 mb-3 tracking-tight">Quality Inspection</h3>
            <p class="text-sm text-stone-600 leading-relaxed font-light">
              Every item is individually inspected and verified against our standards before careful packaging and delivery.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Custom Orders Callout -->
  <section class="py-16 sm:py-24 lg:py-28 bg-surface">
    <div class="container-page">
      <div class="rounded-2xl bg-stone-950 text-white p-8 sm:p-14 lg:p-20 relative overflow-hidden border border-stone-800 shadow-elevated">
        <!-- Subtle architectural grid texture -->
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto text-center">
          <p class="text-xs uppercase tracking-widest text-stone-400 font-mono mb-3">Custom Orders</p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight mb-6 text-balance">
            Have a Specific Vision in Mind?
          </h2>
          <p class="text-base sm:text-lg text-stone-300 font-light leading-relaxed mb-10 text-pretty">
            Looking for personalized pieces, bespoke orders, or tailored solutions? Reach out to discuss your project requirements with our team.
          </p>
          {hasWhatsApp() ? (
            <Button href={getWhatsAppLink("Hi! I'm interested in custom orders.")} variant="inverted" size="lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="mr-2">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Discuss via WhatsApp
            </Button>
          ) : (
            <Button href="/custom" variant="inverted" size="lg">
              Explore Custom Orders
            </Button>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-16 sm:py-20 lg:py-24 bg-surface border-t border-border">
    <div class="container-page max-w-xl text-center">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-stone-100 border border-stone-200 text-[11px] font-mono text-stone-600 mb-4">
        <span>Template Placeholder</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-stone-900 mb-3">Join the Newsletter</h2>
      <p class="text-sm sm:text-base text-stone-600 mb-8 font-light">New product releases, exclusive offers, and design stories delivered to your inbox.</p>
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3">
        <input
          type="email"
          id="newsletter-email"
          placeholder="Enter your email address"
          class="flex-1 px-4 py-3 border border-border rounded-md focus:outline-none focus:border-stone-900 bg-surface-bright text-sm transition-colors text-stone-900 placeholder:text-stone-400"
          required
        />
        <Button type="submit">Subscribe</Button>
      </form>
      <div id="newsletter-status" class="hidden mt-3 text-xs font-mono text-stone-600 p-2.5 rounded bg-stone-100 border border-border"></div>
      <p class="text-xs text-stone-400 mt-3 font-light font-mono">Template Demo · Wire to email provider (Phase 3)</p>
    </div>
  </section>

  <script>
    const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const newsletterStatus = document.getElementById('newsletter-status');

    newsletterForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (newsletterStatus) {
        newsletterStatus.textContent = 'Email recorded! (Template Placeholder: Connect newsletter provider in Phase 3).';
        newsletterStatus.classList.remove('hidden');
      }
    });
  </script>











<script src="/carousel.js" is:inline></script>
</Layout>






